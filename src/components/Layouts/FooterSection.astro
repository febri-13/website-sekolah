---
// Premium Footer
---

<footer class="bg-[#060608] text-gray-400 py-24 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-primary-500/50 to-transparent"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-900/10 rounded-full blur-[120px] -z-10"></div>
    <div class="absolute top-0 left-1/3 w-[600px] h-[600px] bg-secondary-900/5 rounded-full blur-[150px] -z-10"></div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-4 gap-16 mb-20">
            <div class="lg:col-span-2">
                <a href="/" class="group inline-block mb-8">
                    <img
                        src="/abbs_logos/logo.png"
                        alt="SMP ABBS Surakarta Logo"
                        class="w-48 h-16 object-contain opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
                        height="64"
                        width="192"
                    />
                </a>
                <p class="text-lg text-gray-500 max-w-md leading-relaxed mb-8">
                    Sekolah Menengah Pertama Al Abidin Bilingual Boarding School. Mencetak pemimpin masa depan dengan karakter Islami dan wawasan global.
                </p>
                <div class="flex gap-3">
                    {[
                        { name: 'facebook', href: '#' },
                        { name: 'instagram', href: 'https://www.instagram.com/smpabbssurakarta' },
                        { name: 'youtube', href: 'https://www.youtube.com/@SMPABBSSURAKARTA' },
                    ].map((social) => (
                        <a href={social.href} class="w-11 h-11 rounded-xl bg-white/[0.04] flex items-center justify-center hover:bg-primary-600 hover:text-white hover:shadow-lg hover:shadow-primary-500/20 hover:-translate-y-0.5 transition-all duration-300 border border-white/[0.06] hover:border-primary-500/30">
                            <i data-feather={social.name} class="w-4 h-4"></i>
                        </a>
                    ))}
                </div>
            </div>

            <div>
                <h4 class="text-white font-black mb-8 tracking-wider uppercase text-xs">Quick Links</h4>
                <ul class="space-y-4">
                    {[
                        { name: 'Tentang Kami', href: '/tentang' },
                        { name: 'Program Unggulan', href: '/program' },
                        { name: 'Berita & Kegiatan', href: '/berita' },
                        { name: 'Pendaftaran', href: '#' },
                        { name: 'Kontak Kami', href: '/kontak' },
                    ].map((link) => (
                        <li>
                            <a href={link.href} class="text-gray-500 hover:text-white transition-colors duration-300 inline-flex items-center gap-2 group text-sm">
                                <span class="w-0 group-hover:w-3 h-px bg-primary-500 transition-all duration-300 rounded-full"></span>
                                {link.name}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <div>
                <h4 class="text-white font-black mb-8 tracking-wider uppercase text-xs">Hubungi Kami</h4>
                <div class="space-y-5">
                    <a href="https://maps.app.goo.gl/nhtZbKCV35aSe5dXA" class="flex items-start gap-3 group">
                        <div class="w-9 h-9 rounded-lg bg-white/[0.04] flex items-center justify-center group-hover:bg-primary-900/30 group-hover:text-primary-400 transition-all duration-300 flex-shrink-0 border border-white/[0.06]">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        </div>
                        <span class="text-sm leading-relaxed group-hover:text-gray-300 transition-colors duration-300">
                            Jl. Tarumanegara III, Banyuanyar, Banjarsari, Surakarta, Jawa Tengah 57137
                        </span>
                    </a>
                    <a href="tel:+6282242719492" class="flex items-center gap-3 group">
                        <div class="w-9 h-9 rounded-lg bg-white/[0.04] flex items-center justify-center group-hover:bg-primary-900/30 group-hover:text-primary-400 transition-all duration-300 flex-shrink-0 border border-white/[0.06]">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        </div>
                        <span class="text-sm group-hover:text-gray-300 transition-colors duration-300">+62 822-4271-9492</span>
                    </a>
                    <a href="mailto:smpabbs@alabidin.sch.id" class="flex items-center gap-3 group">
                        <div class="w-9 h-9 rounded-lg bg-white/[0.04] flex items-center justify-center group-hover:bg-primary-900/30 group-hover:text-primary-400 transition-all duration-300 flex-shrink-0 border border-white/[0.06]">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <span class="text-sm group-hover:text-gray-300 transition-colors duration-300">smpabbs@alabidin.sch.id</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="pt-10 border-t border-white/[0.05] flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-xs text-gray-600">
                &copy; {new Date().getFullYear()} SMP ABBS Surakarta. All rights reserved.
            </p>
            <div class="flex gap-6 items-center">
                <img src="/abbs_logos/ict.png" alt="ICT" class="h-7 object-contain opacity-50 hover:opacity-100 transition-opacity" />
                <img src="/abbs_logos/tcp.png" alt="TCP" class="h-7 object-contain opacity-50 hover:opacity-100 transition-opacity" />
            </div>
        </div>
    </div>
</footer>
