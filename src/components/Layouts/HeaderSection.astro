---
import ThemeToggle from "./ThemeToggle.astro";
import CommunityHover from "../CommunityHover.astro";
---

<header
    class="sticky top-0 z-50 bg-white/95 dark:bg-gray-900/95 backdrop-blur-lg border-b border-cream-200 dark:border-gray-700 shadow-lg"
>
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <img
                onclick="window.location.href='/'"
                src="/logo.png"
                alt="ABBS Logo"
                class="w-48 h-16 object-contain cursor-pointer hover:opacity-80 transition-opacity"
                height="64"
                width="192"
            />
        </div>

        <nav class="hidden md:flex flex-1 justify-center items-center gap-8">
            <a
                href="/"
                class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium text-sm"
            >
                Beranda
            </a>
            <a
                href="/tentang"
                class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium text-sm"
            >
                Tentang
            </a>
            <a
                href="/program"
                class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium text-sm"
            >
                Program
            </a>
            <a
                href="/berita"
                class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium text-sm"
            >
                Berita
            </a>
            <a
                href="/kontak"
                class="text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium text-sm"
            >
                Kontak
            </a>
            <CommunityHover />
        </nav>

        <ThemeToggle />
    </div>
</header>
