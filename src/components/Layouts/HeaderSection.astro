---
import ThemeToggle from "./ThemeToggle.astro";
import CommunityHover from "../CommunityHover.astro";
---

<header
    id="main-header"
    class="fixed top-0 left-0 z-50 w-full transition-all duration-500"
>
    <div class="glass-container px-[44px] flex items-center border-b border-white/20 dark:border-white/5 shadow-md backdrop-blur-xl bg-white/60 dark:bg-gray-900/60 w-full" style="height: 90px;">
        <div class="w-full flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a href="/" class="group flex items-center">
                <img
                    src="/abbs_logos/logo.png"
                    alt="SMP ABBS Surakarta Logo"
                    class="w-44 h-12 object-contain group-hover:scale-105 transition-all duration-300 filter drop-shadow-sm"
                    height="48"
                    width="176"
                />
            </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-2">
            {[
                { name: 'Beranda', href: '/' },
                { name: 'Tentang', href: '/tentang' },
                { name: 'Program', href: '/program' },
                { name: 'Berita', href: '/berita' },
                { name: 'Kontak', href: '/kontak' },
            ].map((link) => (
                <a
                    href={link.href}
                    class="px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 transition-all relative group"
                >
                    {link.name}
                    <span class="absolute bottom-1 left-4 right-4 h-0.5 bg-primary-500 scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
                </a>
            ))}
            <div class="mx-2 h-6 w-px bg-gray-300/50 dark:bg-gray-700/50"></div>
            <CommunityHover />
        </nav>

        <div class="flex items-center gap-3">
            <div class="hidden sm:flex items-center gap-3">
                <ThemeToggle />
                <a 
                    href="/kontak" 
                    class="bg-primary-600 hover:bg-primary-700 text-white px-5 py-2 rounded-xl text-sm font-bold transition-all hover:shadow-lg hover:shadow-primary-500/30 active:scale-95"
                >
                    PPDB 2024
                </a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button 
                id="menu-toggle"
                class="lg:hidden p-2.5 rounded-xl bg-gray-100/50 dark:bg-gray-800/50 text-gray-700 dark:text-gray-200 transition-colors"
                aria-label="Toggle Menu"
            >
                <i data-feather="menu" class="w-5 h-5"></i>
            </button>
        </div>
    </div>
</div>

    <!-- Mobile Menu Drawer -->
    <div 
        id="mobile-menu" 
        class="fixed inset-0 top-0 left-0 w-full h-screen bg-white/95 dark:bg-gray-950/95 backdrop-blur-2xl z-[-1] opacity-0 pointer-events-none transition-all duration-500 flex flex-col items-center justify-center gap-8 lg:hidden"
    >
        {[
            { name: 'Beranda', href: '/' },
            { name: 'Tentang', href: '/tentang' },
            { name: 'Program', href: '/program' },
            { name: 'Berita', href: '/berita' },
            { name: 'Komunitas', href: '/komunitas_siswa' },
            { name: 'Kontak', href: '/kontak' },
        ].map((link) => (
            <a
                href={link.href}
                class="text-2xl font-bold text-gray-800 dark:text-white hover:text-primary-500 transition-colors"
            >
                {link.name}
            </a>
        ))}
        <div class="h-px w-24 bg-gray-200 dark:bg-gray-800"></div>
        <div class="flex items-center gap-6">
            <ThemeToggle />
            <a 
                href="/kontak" 
                class="bg-primary-600 text-white px-8 py-3 rounded-2xl font-bold shadow-xl shadow-primary-500/20"
            >
                Daftar Sekarang
            </a>
        </div>
    </div>
</header>

<div style="height: 90px;"></div>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.getElementById('main-header');
    let isMenuOpen = false;

    menuToggle?.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen) {
            mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
            mobileMenu?.classList.add('opacity-100', 'pointer-events-auto');
            document.body.style.overflow = 'hidden';
            // Change icon to x if possible, or just animate
        } else {
            mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
            mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto');
            document.body.style.overflow = '';
        }
    });

    // Scroll effect disabled as per user request
    /*
    window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
            header?.classList.add('top-2', 'w-full', 'max-w-full');
            header?.classList.remove('top-6', 'w-[95%]', 'max-w-7xl');
        } else {
            header?.classList.remove('top-2', 'w-full', 'max-w-full');
            header?.classList.add('top-6', 'w-[95%]', 'max-w-7xl');
        }
    });
    */
</script>

<style>
    .glass-container {
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
</style>


