---
// src/components/cta/CTASection.astro

interface Props {
  id?: string;
  title?: string;
  description?: string;
  primaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
}

const {
  id = 'daftar',
  title = 'Bergabunglah Bersama Kami',
  description = 'Wujudkan masa depan cerah putra-putri Anda dengan pendidikan berkualitas di ABBS Surakarta',
  primaryButton = {
    text: 'Hubungi Kami',
    href: '/kontak',
    icon: 'phone'
  },
  secondaryButton = {
    text: 'Download Brosur',
    href: '#',
    icon: 'download'
  }
} = Astro.props;
---

<section id={id} class="py-24 bg-gradient-to-br from-primary-600 via-primary-500 to-tertiary-500 text-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary-400/15 rounded-full blur-3xl"></div>
  
  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
      {title}
    </h2>
    <p class="text-xl mb-10 text-primary-100 max-w-2xl mx-auto leading-relaxed">
      {description}
    </p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a 
        href={primaryButton.href}
        class="bg-secondary-400 text-gray-900 px-8 py-4 rounded-xl font-bold hover:bg-secondary-300 transition-all shadow-xl text-lg inline-flex items-center gap-2 transform hover:scale-105"
      >
        {primaryButton.icon && <i data-feather={primaryButton.icon} class="inline-block w-5 h-5" />} {primaryButton.text}
      </a>
      <a 
        href={secondaryButton.href}
        class="bg-white text-primary-600 px-8 py-4 rounded-xl font-bold hover:bg-primary-50 transition-all shadow-xl text-lg inline-flex items-center gap-2 transform hover:scale-105"
      >
        {secondaryButton.icon && <i data-feather={secondaryButton.icon} class="inline-block w-5 h-5" />} {secondaryButton.text}
      </a>
    </div>
  </div>
</section>