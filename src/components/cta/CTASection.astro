---
// Premium CTA Section with animated gradient, floating particles, and magnetic button

interface Props {
  id?: string;
  title?: string;
  description?: string;
  primaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
    icon?: string;
  };
}

const {
  id = 'daftar',
  title = 'Bergabunglah Bersama Kami',
  description = 'Wujudkan masa depan cerah putra-putri Anda dengan pendidikan berkualitas di SMP ABBS Surakarta',
  primaryButton = {
    text: 'Hubungi Kami',
    href: '/kontak',
    icon: 'phone'
  },
  secondaryButton = {
    text: 'Download Brosur',
    href: '#',
    icon: 'download'
  }
} = Astro.props;
---

<section id={id} class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 reveal reveal-scale">
    <div class="relative rounded-[3rem] overflow-hidden bg-gradient-to-br from-secondary-700 via-secondary-600 to-primary-700 p-12 md:p-20 text-center shadow-2xl">

      <!-- Animated mesh gradient background -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-1/2 -left-1/2 w-[800px] h-[800px] bg-primary-400/10 rounded-full blur-[120px] animate-mesh-move"></div>
        <div class="absolute -bottom-1/2 -right-1/2 w-[600px] h-[600px] bg-accent-400/10 rounded-full blur-[100px] animate-mesh-move" style="animation-delay: -10s;"></div>
      </div>

      <!-- Decorative SVG -->
      <div class="absolute top-0 right-0 w-full h-full opacity-[0.05] pointer-events-none">
        <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
          <path d="M0 100 C 20 0 50 0 100 100 Z" fill="white"></path>
        </svg>
      </div>

      <!-- Floating particles -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute w-2 h-2 bg-white/20 rounded-full top-[20%] left-[15%] animate-float-slow"></div>
        <div class="absolute w-1.5 h-1.5 bg-accent-400/30 rounded-full top-[30%] right-[20%] animate-float" style="animation-delay: -3s;"></div>
        <div class="absolute w-1 h-1 bg-white/15 rounded-full bottom-[25%] left-[25%] animate-float-sideways" style="animation-delay: -5s;"></div>
        <div class="absolute w-2.5 h-2.5 bg-primary-300/20 rounded-full bottom-[35%] right-[10%] animate-float-slow" style="animation-delay: -7s;"></div>
      </div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-8 leading-tight tracking-tight">
          {title}
        </h2>
        <p class="text-xl md:text-2xl text-white/80 mb-12 font-light leading-relaxed">
          {description}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a
            href={primaryButton.href}
            class="w-full sm:w-auto px-10 py-5 bg-accent-500 text-secondary-900 rounded-2xl font-black text-lg hover:bg-accent-400 transition-all duration-300 shadow-xl shadow-accent-500/20 hover:shadow-accent-500/40 hover:scale-105 active:scale-95 inline-flex items-center justify-center gap-3 magnetic"
          >
            {primaryButton.icon && <i data-feather={primaryButton.icon} class="w-5 h-5" />} {primaryButton.text}
          </a>
          <a
            href={secondaryButton.href}
            class="w-full sm:w-auto px-10 py-5 bg-white/[0.1] backdrop-blur-md text-white border border-white/25 rounded-2xl font-bold text-lg hover:bg-white/20 hover:border-white/40 transition-all duration-300 hover:scale-105 active:scale-95 inline-flex items-center justify-center gap-3 magnetic"
          >
            {secondaryButton.icon && <i data-feather={secondaryButton.icon} class="w-5 h-5" />} {secondaryButton.text}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
