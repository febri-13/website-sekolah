---
import { createClient } from '@sanity/client';

const sanityClient = createClient({
  projectId: import.meta.env.PUBLIC_SANITY_PROJECT_ID,
  dataset: import.meta.env.PUBLIC_SANITY_DATASET,
  useCdn: true,
  apiVersion: import.meta.env.PUBLIC_SANITY_API_VERSION || '2024-01-01',
});

interface Feature {
  _id?: string;
  order: number;
  title: string;
  description: string;
  icon: string;
  borderColor: string;
  gradientFrom: string;
  gradientTo: string;
  isActive?: boolean;
}

const features = await sanityClient.fetch<Feature[]>(
  `*[_type == "features" && isActive == true] | order(order asc) [0...6]`
);

const defaultFeatures: Feature[] = [
  {
    order: 1,
    title: 'Kurikulum Bilingual',
    description: 'Pembelajaran dwi bahasa (Indonesia & Inggris) dengan metode modern dan interaktif',
    icon: 'book',
    borderColor: 'border-primary-500',
    gradientFrom: 'from-primary-500',
    gradientTo: 'to-primary-600',
  },
  {
    order: 2,
    title: 'Pendidikan Islam',
    description: 'Pemahaman agama yang kuat dengan tahfidz Al-Qur\'an dan akhlak mulia',
    icon: 'home',
    borderColor: 'border-accent-500',
    gradientFrom: 'from-accent-500',
    gradientTo: 'to-accent-600',
  },
  {
    order: 3,
    title: 'Boarding School',
    description: 'Asrama nyaman dengan pengawasan 24 jam dan pembinaan karakter terpadu',
    icon: 'home',
    borderColor: 'border-secondary-400',
    gradientFrom: 'from-secondary-400',
    gradientTo: 'to-secondary-500',
  },
  {
    order: 4,
    title: 'Teknologi Modern',
    description: 'Fasilitas IT lengkap dengan pembelajaran berbasis teknologi digital',
    icon: 'monitor',
    borderColor: 'border-primary-500',
    gradientFrom: 'from-primary-500',
    gradientTo: 'to-primary-600',
  },
  {
    order: 5,
    title: 'Ekstrakurikuler',
    description: 'Beragam kegiatan untuk mengembangkan bakat dan minat siswa',
    icon: 'zap',
    borderColor: 'border-accent-500',
    gradientFrom: 'from-accent-500',
    gradientTo: 'to-accent-600',
  },
  {
    order: 6,
    title: 'Prestasi Gemilang',
    description: 'Track record juara di berbagai kompetisi tingkat regional hingga nasional',
    icon: 'star',
    borderColor: 'border-secondary-400',
    gradientFrom: 'from-secondary-400',
    gradientTo: 'to-secondary-500',
  },
];

const displayFeatures = features.length > 0 ? features : defaultFeatures;
---

<section id="tentang" class="py-28 relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-1/4 -right-20 w-96 h-96 bg-primary-500/[0.03] rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-secondary-500/[0.03] rounded-full blur-3xl -z-10"></div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-20 reveal reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 dark:bg-primary-900/20 text-primary-600 dark:text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-6 border border-primary-200/50 dark:border-primary-800/30">
        Keunggulan Kami
      </div>
      <h2 class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white mb-6 tracking-tight">
        Kenapa <span class="text-gradient">ABBS?</span>
      </h2>
      <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto text-lg md:text-xl font-light">
        Fasilitas dan program unggulan yang dirancang untuk membekali siswa dengan kompetensi masa depan.
      </p>
      <div class="w-20 h-1 bg-gradient-to-r from-primary-500 via-secondary-500 to-accent-500 rounded-full mx-auto mt-8"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {displayFeatures.map((feature, index) => (
        <div
          class={`group relative reveal ${index % 3 === 0 ? 'reveal-left' : index % 3 === 1 ? 'reveal-up' : 'reveal-right'}`}
          style={`transition-delay: ${index * 120}ms`}
        >
          <div class={`absolute inset-0 bg-gradient-to-br ${feature.gradientFrom} ${feature.gradientTo} opacity-0 group-hover:opacity-[0.07] blur-2xl transition-opacity duration-700 rounded-3xl`}></div>

          <div class="relative h-full bg-white dark:bg-gray-900/40 backdrop-blur-sm rounded-3xl p-8 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-2xl hover:shadow-primary-500/5 transition-all duration-500 group-hover:-translate-y-2 overflow-hidden">
            <!-- Top gradient accent line -->
            <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${feature.gradientFrom} ${feature.gradientTo} scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left`}></div>

            <!-- Icon -->
            <div class={`w-14 h-14 bg-gradient-to-br ${feature.gradientFrom} ${feature.gradientTo} rounded-2xl flex items-center justify-center text-white mb-6 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500`}>
              <i data-feather={feature.icon} class="w-7 h-7"></i>
            </div>

            <!-- Content -->
            <h3 class="text-xl font-black text-gray-900 dark:text-white mb-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-300 tracking-tight">
              {feature.title}
            </h3>
            <p class="text-gray-500 dark:text-gray-400 leading-relaxed font-light text-sm">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
