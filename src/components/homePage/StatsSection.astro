---
import { sanityClient } from "../../lib/sanity";

interface Stat {
  _id?: string;  // ← Tambah optional
  order: number;
  value: string;
  label: string;
  icon?: string;
  isActive?: boolean;  // ← Tambah optional
}

const stats = await sanityClient.fetch<Stat[]>(
  `*[_type == "stats" && isActive == true] | order(order asc) [0...4]`
);

const defaultStats: Stat[] = [
  { order: 1, value: '500+', label: 'Siswa Aktif', icon: 'user' },
  { order: 2, value: '50+', label: 'Guru Berpengalaman', icon: 'users' },
  { order: 3, value: '20+', label: 'Prestasi', icon: 'star' },
  { order: 4, value: '15', label: 'Tahun Berdiri', icon: 'calendar' },
];

const displayStats = stats.length > 0 ? stats : defaultStats;
---

<section class="py-24 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gray-200 dark:via-gray-800 to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {displayStats.map((stat, index) => (
        <div class={`relative group reveal ${
          index % 3 === 0 ? 'reveal-left' : 
          index % 3 === 1 ? 'reveal-right' : 
          'reveal-scale'
        }`} style={`transition-delay: ${index * 100}ms`}>
          <div class="absolute inset-0 bg-primary-500/5 blur-2xl rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="relative bg-white dark:bg-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1">
            {stat.icon && (
              <div class="mb-6 w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center text-primary-600 dark:text-primary-400 group-hover:scale-110 transition-transform duration-500">
                <i data-feather={stat.icon} class="w-6 h-6" />
              </div>
            )}
            <div class="text-4xl md:text-5xl font-black tracking-tight text-gray-900 dark:text-white mb-2">
              {stat.value}
            </div>
            <div class="text-gray-500 dark:text-gray-400 font-medium tracking-wide text-sm uppercase">
              {stat.label}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>