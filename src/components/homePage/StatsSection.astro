---
import { sanityClient } from "../../lib/sanity";

interface Stat {
  _id?: string;  // ← Tambah optional
  order: number;
  value: string;
  label: string;
  icon?: string;
  isActive?: boolean;  // ← Tambah optional
}

const stats = await sanityClient.fetch<Stat[]>(
  `*[_type == "stats" && isActive == true] | order(order asc) [0...4]`
);

const defaultStats: Stat[] = [
  { order: 1, value: '500+', label: 'Siswa Aktif', icon: 'user' },
  { order: 2, value: '50+', label: 'Guru Berpengalaman', icon: 'users' },
  { order: 3, value: '20+', label: 'Prestasi', icon: 'star' },
  { order: 4, value: '15', label: 'Tahun Berdiri', icon: 'calendar' },
];

const displayStats = stats.length > 0 ? stats : defaultStats;
---

<section class="py-20 bg-cream-100 dark:bg-gray-800 border-y border-cream-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {displayStats.map((stat, index) => (
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-6 md:p-8 text-center shadow-sm hover:shadow-lg transition-all border border-cream-200 dark:border-gray-700">
          {/* ↑ Hapus 'key' attribute, ganti pakai index di map */}
          {stat.icon && (
            <div class="mb-4 flex justify-center"><i data-feather={stat.icon} class="inline-block w-8 h-8 text-primary-600 dark:text-primary-400" /></div>
          )}
          <div class="text-3xl md:text-4xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            {stat.value}
          </div>
          <div class="text-gray-600 dark:text-gray-300 font-medium text-sm md:text-base">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>