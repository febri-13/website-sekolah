---
// Epic Cinematic Hero Section
---

<section
    id="hero"
    class="relative w-full min-h-screen flex items-center justify-center overflow-hidden"
>
    <!-- Background Video with Multi-Layer Overlay -->
    <div class="absolute inset-0 z-0">
        <iframe
            class="w-full h-full object-cover scale-[1.5]"
            src="https://www.youtube-nocookie.com/embed/E2NzAyXjExc?si=3B86aZivOYxjlzEM&controls=0&autoplay=1&mute=1&loop=1&playlist=E2NzAyXjExc"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>

        <!-- Layer 1: Dark gradient base -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/50 to-black/70"></div>

        <!-- Layer 2: Animated mesh gradient blobs -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute -top-1/4 -left-1/4 w-[800px] h-[800px] bg-primary-600/20 rounded-full blur-[150px] animate-mesh-move"></div>
            <div class="absolute -bottom-1/4 -right-1/4 w-[600px] h-[600px] bg-secondary-500/15 rounded-full blur-[120px] animate-mesh-move" style="animation-delay: -7s;"></div>
            <div class="absolute top-1/3 left-1/2 w-[400px] h-[400px] bg-accent-500/10 rounded-full blur-[100px] animate-mesh-move" style="animation-delay: -14s;"></div>
        </div>

        <!-- Layer 3: Animated grid lines -->
        <div class="absolute inset-0 opacity-[0.03]"
            style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 80px 80px;">
        </div>

        <!-- Layer 4: Floating geometric elements -->
        <div class="absolute top-[12%] left-[8%] opacity-[0.15] animate-float-slow" style="animation-delay: 0s;">
            <svg class="w-16 h-16 text-primary-400" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.5">
                <polygon points="50,5 95,27.5 95,72.5 50,95 5,72.5 5,27.5" />
                <polygon points="50,20 80,35 80,65 50,80 20,65 20,35" />
            </svg>
        </div>
        <div class="absolute top-[18%] right-[12%] opacity-[0.12] animate-float" style="animation-delay: -2s;">
            <svg class="w-20 h-20 text-white" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.5">
                <circle cx="50" cy="50" r="45" />
                <circle cx="50" cy="50" r="30" />
                <circle cx="50" cy="50" r="15" />
                <line x1="50" y1="5" x2="50" y2="95" />
                <line x1="5" y1="50" x2="95" y2="50" />
            </svg>
        </div>
        <div class="absolute bottom-[22%] left-[12%] opacity-[0.15] animate-float-sideways" style="animation-delay: -1s;">
            <svg class="w-14 h-14 text-accent-400" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="0.8">
                <path d="M50 5L61 40H95L67 62L78 95L50 73L22 95L33 62L5 40H39Z" />
            </svg>
        </div>
        <div class="absolute bottom-[15%] right-[18%] opacity-[0.1] animate-float-slow" style="animation-delay: -5s;">
            <svg class="w-12 h-12 text-white" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="20" y="20" width="60" height="60" rx="10" transform="rotate(45 50 50)" />
            </svg>
        </div>

        <!-- Layer 5: Floating particles -->
        <div class="absolute inset-0 pointer-events-none" id="hero-particles"></div>

        <!-- Layer 6: Bottom gradient fade -->
        <div class="absolute bottom-0 left-0 w-full h-48 bg-gradient-to-t from-[#fafaf9] dark:from-[#0a0a0a] to-transparent z-10"></div>
    </div>

    <!-- Main Content -->
    <div class="relative z-20 max-w-6xl mx-auto px-6 text-center" id="hero-content">
        <!-- Badge -->
        <div class="hero-badge inline-flex items-center gap-3 px-5 py-2.5 mb-10 rounded-full bg-white/[0.08] backdrop-blur-xl border border-white/[0.12] text-white text-xs md:text-sm font-bold tracking-[0.25em] uppercase opacity-0 translate-y-8" style="animation: hero-text-stagger 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-500"></span>
            </span>
            <div class="w-px h-3 bg-white/30"></div>
            SMP ABBS Surakarta
        </div>

        <!-- Main Heading -->
        <h1 class="text-7xl md:text-[8.5rem] font-[900] text-white mb-8 leading-[0.85] tracking-tighter">
            <span class="hero-word inline-block opacity-0 translate-y-12" style="animation: hero-text-stagger 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;">Build</span>
            <span class="hero-word inline-block opacity-0 translate-y-12" style="animation: hero-text-stagger 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;">Your</span>
            <br class="hidden md:block" />
            <span class="hero-word inline-block opacity-0 translate-y-12 text-transparent bg-clip-text bg-gradient-to-r from-primary-300 via-accent-300 to-primary-400 animate-gradient-shift" style="animation: hero-text-stagger 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards, gradient-shift 6s ease infinite; background-size: 200% 200%;">Legacy.</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-sub text-xl md:text-2xl text-white/80 max-w-3xl mx-auto mb-14 leading-relaxed font-light opacity-0 translate-y-8 text-balance" style="animation: hero-text-stagger 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;">
            Bilingual Boarding School dengan Akreditasi A.
            Membentuk pemimpin masa depan dengan
            <span class="font-bold text-primary-300">Karakter Islami</span> dan
            <span class="font-bold text-accent-300">Wawasan Global</span>.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-5 opacity-0 translate-y-8" style="animation: hero-text-stagger 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1s forwards;">
            <a href="/program" class="group relative px-10 py-5 bg-white text-gray-900 rounded-2xl font-bold transition-all duration-300 hover:scale-[1.05] hover:shadow-[0_25px_50px_-10px_rgba(0,151,156,0.5)] overflow-hidden magnetic">
                <span class="relative z-10 flex items-center gap-3">
                    Jelajahi Program
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-primary-400 to-accent-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <span class="absolute inset-0 z-10 flex items-center justify-center gap-3 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    Jelajahi Program
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                </span>
            </a>
            <a href="/kontak" class="px-10 py-5 bg-white/[0.08] hover:bg-white/[0.15] backdrop-blur-2xl text-white border border-white/[0.15] hover:border-white/[0.3] rounded-2xl font-bold transition-all duration-300 hover:scale-[1.05] magnetic flex items-center gap-3">
                Hubungi Kami
                <svg class="w-5 h-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            </a>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-3 opacity-0" style="animation: hero-text-stagger 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;">
        <span class="text-[9px] font-black uppercase tracking-[0.4em] text-white/50">Scroll</span>
        <div class="w-px h-10 bg-gradient-to-b from-white/50 to-transparent relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-3 bg-white animate-bounce"></div>
        </div>
    </div>
</section>

<script>
    // Parallax on mouse move
    const hero = document.getElementById('hero');
    const heroContent = document.getElementById('hero-content');
    const shapes = hero?.querySelectorAll('.animate-float-slow, .animate-float, .animate-float-sideways');

    document.addEventListener('mousemove', (e) => {
        if (!hero || !heroContent) return;
        const rect = hero.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        heroContent.style.transform = `translate(${x * -8}px, ${y * -8}px)`;

        shapes?.forEach((shape, i) => {
            const factor = (i + 1) * 4;
            (shape as HTMLElement).style.transform = `translate(${x * factor}px, ${y * factor}px)`;
        });
    });
</script>

<style>
    @keyframes shimmer {
        100% { transform: translateX(100%); }
    }

    /* Hero entrance stagger */
    .hero-badge,
    .hero-word,
    .hero-sub,
    .hero-cta {
        perspective: 800px;
    }
</style>
