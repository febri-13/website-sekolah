---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="page" id={id}>
  <div class="front bg-slate-50 border-l border-slate-300">
    <div class="p-16 flex flex-col items-center justify-center h-full text-center">
      <div class="w-24 h-24 bg-[#004d4d] rounded-full flex items-center justify-center mb-8 shadow-2xl">
        <i data-feather="award" class="text-white w-12 h-12"></i>
      </div>
      <h2 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tighter font-serif">Dare to Excel?</h2>
      <p class="text-slate-500 text-xs mb-12 max-w-xs uppercase tracking-[0.2em] font-serif font-bold">The Journey Starts Here.</p>
      <div class="flex flex-col gap-5 w-full max-w-[280px]">
        <a href="https://instagram.com/sinaps_abbs" target="_blank" class="flex items-center justify-center gap-3 px-8 py-4 bg-[#E1306C] text-white rounded shadow-lg font-serif font-bold text-xs tracking-widest hover:scale-105 transition-transform">
          <i data-feather="instagram" class="w-5 h-5"></i> @SINAPS_ABBS
        </a>
        <button onclick="window.flipPage(-7)" class="text-[10px] font-serif italic text-slate-400 hover:text-slate-600 transition-colors uppercase tracking-[0.4em]">Return to Cover</button>
      </div>
    </div>
  </div>
  <div class="back bg-[#002b2b] border-r border-black/40 shadow-inner relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');"></div>
    <div class="p-16 h-full flex flex-col items-center justify-center text-center">
      <img src="/communities/sinaps.png" alt="SINAPS" class="w-28 mx-auto mb-10 opacity-30 grayscale" />
      <h2 class="text-2xl font-serif font-black mb-16 uppercase tracking-[0.6em] text-white/20 italic">End of Archive</h2>
      <a href="/komunitas_siswa" class="px-12 py-5 border border-white/10 text-white/30 hover:text-white hover:border-white/30 transition-all text-xs font-serif italic tracking-[0.5em] uppercase">Exit Experience</a>
    </div>
  </div>
</div>
