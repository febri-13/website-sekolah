---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div class="page" id={id}>
  <div class="front bg-slate-50 border-l border-slate-300 relative overflow-hidden">
    <!-- Scribble: Math Formulas -->
    <div class="absolute bottom-10 right-10 opacity-10 font-hand text-[9px] text-rose-900 space-y-1 pointer-events-none">
      <p>a² + b² = c²</p>
      <p>x = (-b ± √D) / 2a</p>
      <p>∑ x_i / n</p>
    </div>

    <div class="p-14 h-full flex flex-col relative z-10">
      <div class="flex items-center gap-4 border-b-4 border-rose-600 pb-3 mb-6">
        <h2 class="text-3xl font-black text-rose-950 uppercase tracking-tighter">Mathematics</h2>
      </div>

      <div class="prose prose-slate prose-sm font-serif space-y-3 flex-1">
        <h4 class="text-sm font-bold text-rose-800 uppercase tracking-widest">The Art of Reasoning</h4>
        <div class="text-xs text-slate-600 space-y-2 leading-relaxed">
          <p>Matematika OSN SMP menguji intuisi dan kreativitas dalam pemecahan masalah:</p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Aljabar:</strong> Polinomial, sistem persamaan linear, dan ketidaksamaan.</li>
            <li><strong>Geometri:</strong> Sifat lingkaran, segitiga, dan dalil Pythagoras/Ptolemy.</li>
            <li><strong>Teori Bilangan:</strong> Modulo, keterbagian, FPB &amp; KPK, dan prima.</li>
            <li><span class="border-b border-rose-400 border-dashed">Kombinatorika:</span> Peluang, permutasi/kombinasi, dan PHP.</li>
          </ul>
        </div>
      </div>

      <!-- Tim Koordinator Math -->
      <div class="mt-4 pt-4 border-t border-rose-100">
        <p class="text-[9px] font-bold text-rose-700 uppercase tracking-widest mb-3">Tim Koordinator Math</p>
        <div class="flex gap-4">
          <!-- Putra -->
          <div class="flex items-center gap-2 bg-white/60 border border-rose-100 rounded-xl px-3 py-2 flex-1 group hover:bg-white transition-all duration-200">
            <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-rose-200 flex-shrink-0 group-hover:border-rose-500 transition-all duration-200">
              <img data-pfp src="/sinaps/mora.png" alt="Allegro Morasakhi"
                   class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-400 cursor-zoom-in" />
            </div>
            <div class="min-w-0">
              <p class="text-[8px] text-rose-600 font-bold uppercase tracking-wider">Koord. Putra</p>
              <p class="text-[10px] font-serif font-bold text-slate-800 leading-tight truncate">A. Morasakhi</p>
            </div>
          </div>
          <!-- Putri -->
          <div class="flex items-center gap-2 bg-white/60 border border-rose-100 rounded-xl px-3 py-2 flex-1 group hover:bg-white transition-all duration-200">
            <div class="w-9 h-9 rounded-full overflow-hidden border-2 border-pink-200 flex-shrink-0 group-hover:border-pink-500 transition-all duration-200">
              <img data-pfp src="/sinaps/balqis.png" alt="Balqis Faiha"
                   class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-400 cursor-zoom-in" />
            </div>
            <div class="min-w-0">
              <p class="text-[8px] text-pink-600 font-bold uppercase tracking-wider">Koord. Putri</p>
              <p class="text-[10px] font-serif font-bold text-slate-800 leading-tight truncate">Balqis Faiha</p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-3 flex justify-end">
        <button onclick="window.flipPage(5)" class="text-xs font-serif italic text-rose-700 hover:text-rose-900 transition-colors flex items-center gap-2">Next Page <i data-feather="arrow-right" class="w-4 h-4"></i></button>
      </div>
    </div>
  </div>

  <div class="back bg-slate-50 border-r border-slate-300 shadow-inner relative overflow-hidden">
    <div class="p-16 h-full flex flex-col relative z-10">
      <h2 class="text-2xl font-bold text-slate-800 border-b border-slate-200 pb-4 mb-8">Join the Elite</h2>
      <div class="space-y-6 relative">
        <p class="text-sm text-slate-600 leading-relaxed font-serif">
          Siapkan dirimu untuk menjadi bagian dari perwakilan sekolah di ajang sains paling bergengsi di Indonesia.
        </p>
        <!-- Sticky Note -->
        <div class="rotate-2 bg-yellow-100 p-6 shadow-md border border-yellow-200 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-8 h-3 bg-slate-400/20"></div>
          <h4 class="font-bold text-amber-900 text-xs mb-1 uppercase font-serif">Ayo Join OSN SMP ABBS Sekarang!</h4>
          <p class="text-[10px] text-amber-800 font-hand">Hubungi Pembina OSN segera!</p>
        </div>
      </div>
      <div class="mt-auto flex justify-start">
        <button onclick="window.flipPage(-5)" class="text-xs font-serif italic text-slate-700 hover:text-slate-900 transition-colors flex items-center gap-2"><i data-feather="arrow-left" class="w-4 h-4"></i> Back Page</button>
      </div>
    </div>
  </div>
</div>
