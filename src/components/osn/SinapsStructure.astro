---
interface Props {
  id: string;
}

const { id } = Astro.props;

const structure = {
  pembina: {
    name: "Ramadanti Prativi S.Pd., M.Pd.",
    role: "Pembina SINAPS OSN",
    img: "/sinaps/msdanti.png",
    desc: "Oversees all scientific training modules, coordinates administrative programs, and guides the academic growth of the squad."
  },
  board: [
    { name: "Danish Max Oceano",  role: "Ketua Putra SINAPS 25/26",  img: "/sinaps/danish.png" },
    { name: "Carel Queenira",     role: "Ketua Putri SINAPS 25/26",  img: "/sinaps/carel.png"  },
    { name: "Aisyah Nur",         role: "Sekretaris INTI SINAPS",     img: "/sinaps/aisyah.png" },
    { name: "M. Afrizal Kelana",  role: "Bendahara INTI SINAPS",      img: "/sinaps/afiz.png"  },
  ],
  departments: {
    ipa: {
      coordinators: [
        { name: "Muhammad Fardhan",     role: "Koordinator Inti IPA",       img: "/sinaps/fardhan.png", desc: "Directs Physics & Biology syllabus modules, curates practice labs, and maintains olympiad training routines." },
        { name: "Azizah Zahratusyifa",  role: "Wakil Koordinator Inti IPA", img: "/sinaps/azizah.png",  desc: "Assists IPA syllabus scheduling, coordinates peer tutoring, and compiles evaluation logs for delegation prep." },
      ]
    },
    ips: {
      coordinators: [
        { name: "Muhammad Ghifari",  role: "Koordinator Inti IPS",       img: "/sinaps/ghifari.png", desc: "Coordinates historical case reviews, geopolitical studies, and geographic simulations for candidates." },
        { name: "Raisa Putri",       role: "Wakil Koordinator Inti IPS", img: "/sinaps/raisa.png",   desc: "Supports IPS curriculum mapping, manages map reading practices, and coordinates sociology drills." },
      ]
    },
    math: {
      coordinators: [
        { name: "Allegro Morasakhi",  role: "Koordinator Inti Math",       img: "/sinaps/mora.png",   desc: "Develops arithmetic masterclasses, algebra/modulo problems, and designs advanced combinatorics drills." },
        { name: "Balqis Faiha",       role: "Wakil Koordinator Inti Math", img: "/sinaps/balqis.png", desc: "Manages geometry worksheet evaluation, runs peer review sessions, and coordinates math mock exams." },
      ]
    }
  }
};
---

<div class="page" id={id}>

  <!-- ══ FRONT: Pembina + Core Board ══ -->
  <div class="front bg-slate-50 border-l border-slate-300 relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-36 h-36 bg-teal-900/5 rounded-full pointer-events-none filter blur-xl"></div>

    <div class="p-10 h-full flex flex-col justify-between relative z-10">
      <div>
        <div class="flex items-center gap-3 border-b-2 border-teal-900/10 pb-3 mb-6">
          <i data-feather="users" class="w-5 h-5 text-teal-800"></i>
          <h2 class="text-3xl font-black font-serif text-teal-950 uppercase tracking-tighter">Scholars Board</h2>
        </div>

        <!-- Pembina -->
        <div class="bg-white/40 border border-teal-900/10 rounded-xl p-5 shadow-sm relative group hover:bg-white/80 transition-all duration-300 mb-5">
          <div class="absolute top-4 right-4 text-[8px] font-mono text-teal-800/40 uppercase tracking-widest">Pembina OSN</div>
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-slate-200 shadow-md flex-shrink-0 group-hover:border-teal-500 transition-all duration-300">
              <img data-pfp src={structure.pembina.img} alt={structure.pembina.name}
                   class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 cursor-zoom-in" />
            </div>
            <div>
              <div class="text-[9px] font-bold text-teal-700 uppercase tracking-widest mb-0.5">{structure.pembina.role}</div>
              <h3 class="text-lg font-bold font-serif text-slate-800 leading-tight">{structure.pembina.name}</h3>
            </div>
          </div>
          <p class="text-[11px] text-slate-600 mt-3 leading-relaxed font-serif italic border-l-2 border-teal-600/30 pl-3">
            "{structure.pembina.desc}"
          </p>
        </div>

        <!-- Core Board 2×2 -->
        <div class="grid grid-cols-2 gap-4">
          {structure.board.map((member) => (
            <div class="bg-white/40 border border-slate-200 rounded-xl p-4 shadow-sm relative group hover:bg-white/80 transition-all duration-300">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full overflow-hidden border border-slate-200 shadow-sm flex-shrink-0 group-hover:border-teal-500 transition-all duration-300">
                  <img data-pfp src={member.img} alt={member.name}
                       class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 cursor-zoom-in" />
                </div>
                <div class="min-w-0">
                  <h4 class="text-xs font-bold font-serif text-slate-800 leading-snug group-hover:text-teal-950 transition-colors truncate">{member.name}</h4>
                  <p class="text-[9px] text-slate-500 font-serif leading-none mt-0.5 truncate">{member.role}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-end pt-4 border-t border-slate-200">
        <button onclick="window.flipPage(6)" class="text-xs font-serif italic text-teal-700 hover:text-teal-900 transition-colors flex items-center gap-2">
          Subject Coordinators <i data-feather="arrow-right" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ══ BACK: Coordinators with tabs ══ -->
  <div class="back bg-slate-50 border-r border-slate-300 shadow-inner relative overflow-hidden">
    <div class="absolute top-10 left-10 opacity-[0.03] pointer-events-none">
      <pre class="font-mono text-[7px] text-teal-950">
        d/dx[f(x)g(x)] = f'(x)g(x) + f(x)g'(x)
        E = mc²  H₂O -&gt; H⁺ + OH⁻
      </pre>
    </div>

    <div class="p-10 h-full flex flex-col justify-between relative z-10">
      <div>
        <div class="flex items-center gap-3 border-b-2 border-teal-900/10 pb-3 mb-6">
          <i data-feather="award" class="w-5 h-5 text-teal-800"></i>
          <h2 class="text-3xl font-black font-serif text-teal-950 uppercase tracking-tighter">Academic Chairs</h2>
        </div>

        <!-- Tabs -->
        <div class="flex border border-slate-200 rounded-lg p-1 bg-slate-100/50 mb-6 shadow-sm gap-1">
          <button id="osn-tab-ipa"  onclick="switchOsnTab('ipa')"  class="osn-tab-btn flex-1 py-2 text-center text-xs font-serif font-bold rounded-md transition-all duration-300 bg-emerald-50 text-emerald-900 border border-emerald-200">Sains / IPA</button>
          <button id="osn-tab-ips"  onclick="switchOsnTab('ips')"  class="osn-tab-btn flex-1 py-2 text-center text-xs font-serif font-bold rounded-md transition-all duration-300 text-slate-400 hover:text-slate-600">Sosial / IPS</button>
          <button id="osn-tab-math" onclick="switchOsnTab('math')" class="osn-tab-btn flex-1 py-2 text-center text-xs font-serif font-bold rounded-md transition-all duration-300 text-slate-400 hover:text-slate-600">Matematika</button>
        </div>

        <!-- IPA -->
        <div id="osn-content-ipa" class="osn-dept-content space-y-4">
          {structure.departments.ipa.coordinators.map((c) => (
            <div class="bg-white/40 border border-emerald-100 rounded-xl p-4 shadow-sm relative group hover:bg-white/80 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-slate-200 shadow-md flex-shrink-0 group-hover:border-emerald-500 transition-all duration-300">
                  <img data-pfp src={c.img} alt={c.name}
                       class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 cursor-zoom-in" />
                </div>
                <div class="flex-grow min-w-0">
                  <div class="text-[9px] font-bold text-emerald-700 uppercase tracking-widest">{c.role}</div>
                  <h3 class="text-base font-bold font-serif text-slate-800 mt-0.5 leading-tight">{c.name}</h3>
                </div>
              </div>
              <p class="text-[10px] text-slate-500 mt-2.5 leading-relaxed font-serif pl-1 italic">"{c.desc}"</p>
            </div>
          ))}
        </div>

        <!-- IPS -->
        <div id="osn-content-ips" class="osn-dept-content space-y-4 hidden">
          {structure.departments.ips.coordinators.map((c) => (
            <div class="bg-white/40 border border-amber-100 rounded-xl p-4 shadow-sm relative group hover:bg-white/80 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-slate-200 shadow-md flex-shrink-0 group-hover:border-amber-500 transition-all duration-300">
                  <img data-pfp src={c.img} alt={c.name}
                       class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 cursor-zoom-in" />
                </div>
                <div class="flex-grow min-w-0">
                  <div class="text-[9px] font-bold text-amber-700 uppercase tracking-widest">{c.role}</div>
                  <h3 class="text-base font-bold font-serif text-slate-800 mt-0.5 leading-tight">{c.name}</h3>
                </div>
              </div>
              <p class="text-[10px] text-slate-500 mt-2.5 leading-relaxed font-serif pl-1 italic">"{c.desc}"</p>
            </div>
          ))}
        </div>

        <!-- Math -->
        <div id="osn-content-math" class="osn-dept-content space-y-4 hidden">
          {structure.departments.math.coordinators.map((c) => (
            <div class="bg-white/40 border border-rose-100 rounded-xl p-4 shadow-sm relative group hover:bg-white/80 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-slate-200 shadow-md flex-shrink-0 group-hover:border-rose-500 transition-all duration-300">
                  <img data-pfp src={c.img} alt={c.name}
                       class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 cursor-zoom-in" />
                </div>
                <div class="flex-grow min-w-0">
                  <div class="text-[9px] font-bold text-rose-700 uppercase tracking-widest">{c.role}</div>
                  <h3 class="text-base font-bold font-serif text-slate-800 mt-0.5 leading-tight">{c.name}</h3>
                </div>
              </div>
              <p class="text-[10px] text-slate-500 mt-2.5 leading-relaxed font-serif pl-1 italic">"{c.desc}"</p>
            </div>
          ))}
        </div>
      </div>

      <div class="flex justify-between pt-6 border-t border-slate-200">
        <button onclick="window.flipPage(-6)" class="text-xs font-serif italic text-teal-700 hover:text-teal-900 transition-colors flex items-center gap-2">
          <i data-feather="arrow-left" class="w-4 h-4"></i> Scholars Board
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  /* ── Tab switcher ── */
  function switchOsnTab(dept) {
    document.querySelectorAll('.osn-dept-content').forEach(el => el.classList.add('hidden'));
    const content = document.getElementById('osn-content-' + dept);
    if (content) content.classList.remove('hidden');

    document.querySelectorAll('.osn-tab-btn').forEach(btn => {
      btn.className = btn.className
        .replace(/bg-\S+/g, '').replace(/text-emerald-\S+/g, '')
        .replace(/text-amber-\S+/g, '').replace(/text-rose-\S+/g, '')
        .replace(/border(?:\s|$)/g, '').replace(/border-\S+/g, '');
      btn.classList.add('text-slate-400', 'hover:text-slate-600');
    });

    const activeBtn = document.getElementById('osn-tab-' + dept);
    if (!activeBtn) return;
    activeBtn.classList.remove('text-slate-400', 'hover:text-slate-600');
    if (dept === 'ipa')  activeBtn.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
    if (dept === 'ips')  activeBtn.classList.add('bg-amber-50',   'text-amber-900',   'border', 'border-amber-200');
    if (dept === 'math') activeBtn.classList.add('bg-rose-50',    'text-rose-900',    'border', 'border-rose-200');
  }

  /* ── Portrait zoom popup (fixed — bypasses all overflow clipping) ── */
  (function () {
    if (document.getElementById('pfp-popup')) return; // guard: run once

    const popup = document.createElement('div');
    popup.id = 'pfp-popup';
    Object.assign(popup.style, {
      position:      'fixed',
      zIndex:        '99999',
      pointerEvents: 'none',
      width:         '160px',
      height:        '160px',
      borderRadius:  '50%',
      overflow:      'hidden',
      boxShadow:     '0 16px 48px rgba(0,0,0,0.35), 0 0 0 3px #fff, 0 0 0 5px #0d9488',
      opacity:       '0',
      transform:     'scale(0.6)',
      transition:    'opacity 0.18s ease, transform 0.28s cubic-bezier(0.34,1.56,0.64,1)',
      background:    '#e2e8f0',
    });

    const popupImg = document.createElement('img');
    Object.assign(popupImg.style, { width:'100%', height:'100%', objectFit:'cover', display:'block' });
    popup.appendChild(popupImg);
    document.body.appendChild(popup);

    function place(img) {
      const r    = img.getBoundingClientRect();
      const size = 160;
      let top  = r.top - size - 14;
      let left = r.left + r.width / 2 - size / 2;
      if (top < 8) top = r.bottom + 14;                                        // flip below if near top
      left = Math.max(8, Math.min(left, window.innerWidth - size - 8));        // clamp to viewport
      popup.style.top  = top  + 'px';
      popup.style.left = left + 'px';
    }

    document.addEventListener('mouseover', function (e) {
      const img = e.target.closest('[data-pfp]');
      if (!img) return;
      popupImg.src          = img.src;
      place(img);
      popup.style.opacity   = '1';
      popup.style.transform = 'scale(1)';
    });

    document.addEventListener('mouseout', function (e) {
      if (!e.target.closest('[data-pfp]')) return;
      popup.style.opacity   = '0';
      popup.style.transform = 'scale(0.6)';
    });
  })();
</script>

<style>
  .font-hand  { font-family: 'Architects Daughter', cursive; }
  .font-serif { font-family: 'Playfair Display', serif; }
</style>
