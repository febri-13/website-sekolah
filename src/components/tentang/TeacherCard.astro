---
// src/components/tentang/TeacherCard.astro
// Individual teacher card component

interface Props {
  name: string;
  position: string;
  subject?: string;
  photo?: string;
  description?: string;
  colorScheme?: 'primary' | 'secondary' | 'accent';
}

const {
  name,
  position,
  subject,
  photo,
  description,
  colorScheme = 'primary'
} = Astro.props;

const colorClasses = {
  primary: 'from-primary-500 to-primary-600',
  secondary: 'from-secondary-500 to-secondary-600',
  accent: 'from-accent-500 to-accent-600'
};

const gradientClass = colorClasses[colorScheme];
---

<div class="group relative h-full">
  <div class="absolute inset-0 bg-primary-500/5 blur-3xl rounded-[2.5rem] opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
  <div class="relative h-full bg-white dark:bg-gray-900/40 backdrop-blur-sm rounded-[2.5rem] overflow-hidden border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-2xl transition-all duration-700 hover:-translate-y-2">
    
    <!-- Photo Area -->
    <div class="relative h-64 overflow-hidden">
      <div class={`absolute inset-0 bg-gradient-to-br ${gradientClass} opacity-20`}></div>
      {photo ? (
        <img 
          src={photo} 
          alt={name}
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gray-50 dark:bg-gray-800">
          <i data-feather="user" class="w-20 h-20 text-gray-200 dark:text-gray-700"></i>
        </div>
      )}
      <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-white dark:from-gray-900 to-transparent"></div>
    </div>
    
    <!-- Content Area -->
    <div class="p-8 pt-0">
      <div class="mb-4">
        <span class={`inline-block px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-gradient-to-r ${gradientClass} text-white shadow-lg`}>
          {position}
        </span>
      </div>
      <h3 class="text-2xl font-black text-gray-900 dark:text-white mb-2 leading-tight tracking-tight group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {name}
      </h3>
      
      {subject && (
        <div class="flex items-center gap-2 mb-6">
          <div class="w-6 h-6 rounded-lg bg-gray-50 dark:bg-gray-800 flex items-center justify-center">
            <i data-feather="book-open" class="w-3.5 h-3.5 text-gray-400" />
          </div>
          <span class="text-sm font-bold text-gray-400 tracking-wide uppercase">
            {subject}
          </span>
        </div>
      )}
      
      {description && (
        <p class="text-gray-500 dark:text-gray-400 font-light text-sm leading-relaxed line-clamp-3">
          {description}
        </p>
      )}

      <div class="mt-8 pt-8 border-t border-gray-50 dark:border-gray-800/50 flex justify-end items-center">
        <div class="w-10 h-10 rounded-2xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center text-primary-600 dark:text-primary-400 group-hover:translate-x-1 transition-transform">
          <i data-feather="arrow-up-right" class="w-5 h-5"></i>
        </div>
      </div>
    </div>
  </div>
</div>