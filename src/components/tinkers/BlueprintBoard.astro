---
const organization = {
  chairperson: {
    name: "Daffa (8A)",
    role: "Chairperson",
    image: "/chairperson.png",
    level: "LEVEL_01",
    desc: "The Chairperson is responsible for overseeing all organizational activities, coordinating between divisions to ensure synergy, and making strategic decisions to achieve the team's goals, the Chairperson acts as the main representative for the organization in both internal and external affairs.",
    koord_name: "Mr Febri",
    koord_img: "/koord_iot.png"
  },
  sekben: {
    name: "Natha (8A)",
    role: "SekBen",
    image: "/sekben.png",
    desc: "Secretary and Treasurer (SekBen) division handles basic administration and financial management. The Secretary keeps records, documents activities, and manages correspondence, while the Treasurer tracks income and expenses and maintains simple financial reports to support the team’s operations.",
    koord_name: "Mr Febri",
    koord_img: "/koord_iot.png"
  },
  kabids: [
    {
      name: "Jabbar (8A)",
      role: "HEAD // GAME DEVELOPMENT",
      image: "/game_dev.png",
      koord_name: "Mr Musfiq",
      koord_img: "/koord_game.png",
      slogan: "Turning Curiosity into Playable Worlds.",
      desc: "In Game Dev Division We push the boundaries of interaction by transforming raw curiosity into engaging gameplay. We build immersive environments and mechanics that allow users to explore and interact with your ideas."
    },
    {
      name: "Xavier (8B)",
      role: "HEAD // IOT INNOVATION",
      image: "/iot.png",
      koord_name: "Mr Febri",
      koord_img: "/koord_iot.png",
      slogan: "Bringing Creativity to Life.",
      desc: "In IoT Innovation Division We bridge the gap between imagination and the physical world. By leveraging smart sensors and automation, we transform complex ideas into tangible, innovative hardware solutions."
    },
    {
      name: "Ammar (8A)",
      role: "HEAD // WEBSITE CREATIVE",
      image: "/web_dev.png",
      koord_name: "Mr Ifan",
      koord_img: "/koord_web.png",
      slogan: "Digitizing Your Vision.",
      desc: "In Website Creative We bridge the gap between imagination and the physical world. By leveraging smart sensors and automation, we transform complex ideas into tangible, innovative hardware solutions."
    }
  ]
};
---

<div
    id="blueprint-board"
    class="opacity-0 transition-opacity duration-1000 hidden w-full h-full bg-[#001226] text-[#00f2ff] relative overflow-auto p-4 md:p-10"
    style="font-family: 'JetBrains Mono', 'Fira Code', monospace;"
>
    <!-- Futuristic Grid -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div
            class="absolute inset-0"
            style="background-image: 
                linear-gradient(rgba(0, 242, 255, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 242, 255, 0.1) 1px, transparent 1px);
                background-size: 50px 50px;"
        >
        </div>
        <!-- Scanning Line -->
        <div
            class="absolute w-full h-[2px] bg-gradient-to-r from-transparent via-[#00f2ff] to-transparent top-0 opacity-30 scanning-line"
        >
        </div>
    </div>

    <!-- HUD Elements (Corners) -->
    <div
        class="absolute top-10 left-10 w-24 h-24 border-t-4 border-l-4 border-[#00f2ff] opacity-40"
    >
    </div>
    <div
        class="absolute top-10 right-10 w-24 h-24 border-t-4 border-r-4 border-[#00f2ff] opacity-40"
    >
    </div>
    <div
        class="absolute bottom-10 left-10 w-24 h-24 border-b-4 border-l-4 border-[#00f2ff] opacity-40"
    >
    </div>
    <div
        class="absolute bottom-10 right-10 w-24 h-24 border-b-4 border-r-4 border-[#00f2ff] opacity-40"
    >
    </div>

    <!-- Main Content Area -->
    <div
        class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-7xl mx-auto py-12"
    >
        <!-- Header Module (Refined & Static) -->
        <div
            class="lg:col-span-12 mb-12 border-b-2 border-[#00f2ff] pb-8 flex flex-col md:flex-row justify-between items-start md:items-end relative"
        >
            <!-- HUD Corner Details -->
            <div class="absolute -top-4 -left-4 w-8 h-8 border-t border-l border-[#00f2ff]/30"></div>
            <div class="absolute -top-4 -right-4 w-8 h-8 border-t border-r border-[#00f2ff]/30"></div>

            <div class="relative z-10">
                <div
                    class="text-[9px] text-[#00f2ff] opacity-40 mb-2 tracking-[0.5em] uppercase font-bold"
                >
                    System_Status // Archive_2026
                </div>
                <h1
                    class="text-4xl md:text-7xl font-black italic tracking-tighter text-white glow-text mb-4 leading-none"
                >
                    THE TINKERS
                </h1>
                <div
                    class="flex items-center gap-6 text-[10px] tracking-[0.2em] font-mono"
                >
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-[#00f2ff] rounded-full"></span>
                        <span class="text-[#00f2ff] font-bold uppercase"
                            >Status: Operational</span
                        >
                    </div>
                    <div class="h-3 w-[1px] bg-[#00f2ff]/20"></div>
                    <span class="opacity-50 uppercase">Location: SMP ABBS SURAKARTA</span>
                </div>
            </div>

            <div
                class="text-right hidden md:flex flex-col items-end font-mono text-[9px] opacity-60 mt-6 md:mt-0"
            >
                <div class="mb-2 flex items-center gap-2">
                    <span class="opacity-40">EST_DATE:</span>
                    <span class="text-white">27.04.2026</span>
                </div>
                <div class="mb-3 flex items-center gap-2">
                    <span class="opacity-40">SEC_PROTOCOL:</span>
                    <span class="text-[#00f2ff]">ENCRYPTED_v2</span>
                </div>
                <div
                    class="w-48 h-[2px] bg-[#00f2ff]/10 relative overflow-hidden"
                >
                    <div class="absolute inset-0 bg-[#00f2ff] w-full"></div>
                </div>
                <div class="mt-1 text-[8px] opacity-30">DATA_INTEGRITY_VERIFIED</div>
            </div>
        </div>

        <!-- Module 01: Core Protocol (Latar Belakang & Visi) -->
        <div class="lg:col-span-8 group">
            <div
                class="border border-[#00f2ff]/30 p-8 relative bg-[#001226]/60 backdrop-blur-md hover:border-[#00f2ff] transition-all shadow-[inset_0_0_30px_rgba(0,242,255,0.05)] h-full"
            >
                <div
                    class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase tracking-widest"
                >
                    Module_01 // Core_Foundation
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-4">
                    <div>
                        <h2
                            class="text-xs font-bold mb-4 text-[#00f2ff] opacity-50 tracking-[0.2em] uppercase"
                        >
                            // Latar Belakang
                        </h2>
                        <p class="text-sm leading-relaxed text-gray-300">
                            Perkembangan teknologi menuntut siswa tidak hanya
                            memahami teori, tetapi juga kemampuan praktis dan
                            inovatif. <span class="text-[#00f2ff]"
                                >The Tinkers</span
                            > hadir sebagai wadah terstruktur untuk pengembangan ide
                            dan persiapan kompetisi IT secara optimal.
                        </p>
                    </div>
                    <div>
                        <h2
                            class="text-xs font-bold mb-4 text-[#00f2ff] opacity-50 tracking-[0.2em] uppercase"
                        >
                            // Visi Utama
                        </h2>
                        <div
                            class="border-l-2 border-[#00f2ff] pl-4 italic text-sm md:text-base text-white"
                        >
                            "Menjadi wadah unggulan bagi siswa dalam
                            mengembangkan keterampilan teknologi, inovasi, dan
                            kreativitas untuk menghasilkan karya yang kompetitif
                            di tingkat nasional maupun internasional."
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Module 02: Strategic Objectives -->
        <div class="lg:col-span-4">
            <div
                class="border border-[#00f2ff]/30 p-8 bg-[#00f2ff]/5 relative h-full"
            >
                <div
                    class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase"
                >
                    Module_02 // Objectives
                </div>
                <h3
                    class="text-xs font-bold mb-6 mt-4 text-[#00f2ff] tracking-widest uppercase"
                >
                    // Tujuan Strategis
                </h3>
                <ul class="space-y-4">
                    {
                        [
                            "Kreativitas & Inovasi Siswa",
                            "Persiapan Lomba IT Terstruktur",
                            "Project-Based Learning Culture",
                            "Teamwork & Problem Solving",
                        ].map((item, index) => (
                            <li class="flex items-center gap-3 text-xs">
                                <span class="text-[#00f2ff] font-bold">
                                    0{index + 1}
                                </span>
                                <span class="text-gray-300 uppercase tracking-tighter">
                                    {item}
                                </span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <!-- Module 03: Deployment Divisi -->
        <div class="lg:col-span-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {
                    organization.kabids.map((div) => (
                        <div
                            class="div-card border border-[#00f2ff]/20 p-6 bg-[#001226]/80 hover:bg-[#00f2ff]/5 transition-all group relative cursor-pointer overflow-hidden"
                            data-name={div.role.split("// ")[1] || div.role}
                            data-slogan={div.slogan}
                            data-desc={div.desc}
                            data-coord={div.koord_name}
                            data-coord-label="Assigned Coordinator"
                            data-rank-label={`SQUAD LEADER: ${div.name}`}
                            data-coord-rank-label={`COORDINATOR: ${div.koord_name}`}
                            data-coord-img={div.koord_img}
                            data-lead={div.name}
                            data-img={div.image}
                        >
                            <div class="absolute top-0 right-0 p-2 text-[8px] text-[#00f2ff] opacity-0 group-hover:opacity-40 transition-opacity uppercase tracking-widest">
                                Access Division Data
                            </div>
                            <div class="text-[10px] opacity-40 mb-2 font-mono uppercase">
                                DIV_#{div.role.split("// ")[1]?.substring(0, 3) || "UNIT"}
                            </div>
                            <h4 class="text-xl font-black italic text-white mb-4 group-hover:text-[#00f2ff] transition-colors uppercase">
                                {div.role.split("// ")[1] || div.role}
                            </h4>
                            <div class="space-y-2 text-[11px] font-mono border-t border-[#00f2ff]/10 pt-4">
                                <div class="flex justify-between">
                                    <span class="opacity-50 uppercase">
                                        Coordinator:
                                    </span>
                                    <span class="text-[#00f2ff]">
                                        {div.koord_name}
                                    </span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="opacity-50 uppercase">
                                        Leader:
                                    </span>
                                    <span class="text-[#00f2ff] font-bold">
                                        {div.name}
                                    </span>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Division Detail Modal (SEMI-FULLSCREEN) -->
        <div
            id="div-modal"
            class="fixed inset-0 z-[1000] flex items-center justify-center p-4 md:p-10 bg-black/80 backdrop-blur-xl hidden opacity-0 transition-all duration-500 overflow-hidden"
        >
            <div class="relative w-full h-full max-w-7xl bg-[#001226] border-2 border-[#00f2ff]/50 shadow-[0_0_100px_rgba(0,242,255,0.1)] overflow-hidden flex flex-col md:flex-row">
                <!-- Background HUD Elements -->
                <div class="absolute inset-0 pointer-events-none opacity-20">
                    <div
                        class="absolute inset-0"
                        style="background-image: 
                            linear-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px),
                            linear-gradient(90deg, rgba(0, 242, 255, 0.05) 1px, transparent 1px);
                            background-size: 100px 100px;"
                    >
                    </div>
                </div>
                <!-- Left Side: Image Display -->
                <div class="w-full md:w-1/2 h-1/2 md:h-full relative overflow-hidden group/img border-r border-[#00f2ff]/20">
                    <div class="absolute inset-0 bg-[#001226]"></div>
                    <img 
                        id="div-modal-img" 
                        src="" 
                        alt="Division Illustration" 
                        class="w-full h-full object-cover opacity-70 mix-blend-screen grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-1000 scale-110 group-hover/img:scale-100"
                    />
                    
                    <!-- Dynamic Name Tag -->
                    <div class="absolute bottom-10 left-10 z-20">
                        <div class="flex flex-col">
                            <div id="div-modal-label" class="bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-black uppercase tracking-widest inline-block self-start mb-1">
                                SQUAD_LEADER_IDENTIFIED
                            </div>
                            <div class="bg-black/60 backdrop-blur-md border border-[#00f2ff]/50 px-6 py-3">
                                <h3 id="div-modal-tag-lead" class="text-2xl font-black italic text-white uppercase glow-text">
                                    --
                                </h3>
                            </div>
                        </div>
                    </div>

                    <!-- HUD Scanning Lines on Image -->
                    <div class="absolute inset-0 pointer-events-none">
                        <div class="absolute w-full h-[1px] bg-[#00f2ff]/30 top-1/4 animate-pulse"></div>
                        <div class="absolute w-full h-[1px] bg-[#00f2ff]/30 top-2/4 animate-pulse delay-75"></div>
                        <div class="absolute w-full h-[1px] bg-[#00f2ff]/30 top-3/4 animate-pulse delay-150"></div>
                        <div class="absolute h-full w-[1px] bg-[#00f2ff]/30 left-1/4 animate-pulse"></div>
                        <div class="absolute h-full w-[1px] bg-[#00f2ff]/30 left-2/4 animate-pulse delay-75"></div>
                        <div class="absolute h-full w-[1px] bg-[#00f2ff]/30 left-3/4 animate-pulse delay-150"></div>
                    </div>

                    <!-- Image Overlays -->
                    <div class="absolute inset-0 bg-gradient-to-r from-[#001226] via-transparent to-transparent hidden md:block"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-[#001226] via-transparent to-transparent md:hidden"></div>
                    
                    <!-- HUD Corner Brackets for Image -->
                    <div class="absolute top-10 left-10 w-12 h-12 border-t-2 border-l-2 border-[#00f2ff]/40"></div>
                    <div class="absolute top-10 right-10 w-12 h-12 border-t-2 border-r-2 border-[#00f2ff]/40"></div>
                </div>

                <!-- Right Side: Data/Content -->
                <div class="w-full md:w-1/2 h-1/2 md:h-full p-8 md:p-20 flex flex-col justify-center relative overflow-y-auto bg-[#001226]/80 backdrop-blur-sm">
                    <!-- Close Button -->
                    <button
                        id="close-div-modal"
                        class="fixed md:absolute top-8 right-8 z-[1100] group flex items-center gap-3 text-[#00f2ff] hover:text-white transition-all"
                    >
                        <span class="text-[10px] font-bold tracking-[0.3em] uppercase opacity-0 group-hover:opacity-100 transition-opacity"></span>
                        <div class="w-10 h-10 border border-[#00f2ff] flex items-center justify-center font-bold text-sm bg-[#00f2ff]/10 group-hover:bg-[#00f2ff] group-hover:text-black transition-all">
                            X
                        </div>
                    </button>

                    <div class="relative z-10 space-y-10 max-w-2xl w-full mx-auto md:mx-0">
                        <div class="animate-in fade-in slide-in-from-left duration-700 mt-12 md:mt-20">
                            <div class="flex items-center gap-3 mb-6 opacity-60">
                                <div class="h-[1px] w-8 bg-[#00f2ff]"></div>
                                <div class="text-[9px] text-[#00f2ff] tracking-[0.4em] uppercase font-mono">
                                    Operational_Briefing_v2.0
                                </div>
                            </div>
                            
                            <h2
                                id="div-modal-name"
                                class="text-3xl md:text-6xl font-black italic text-white uppercase glow-text leading-tight mb-6"
                            >
                                IoT Innovation
                            </h2>
                            
                            <div
                                class="inline-flex items-center gap-4 px-5 py-2.5 bg-[#00f2ff] text-[#001226] text-xs font-bold uppercase italic shadow-[0_0_20px_rgba(0,242,255,0.3)]"
                            >
                                <span class="animate-pulse">▶</span>
                                <span id="div-modal-slogan">"Bringing Creativity to Life."</span>
                            </div>
                        </div>

                        <div class="space-y-10 animate-in fade-in slide-in-from-bottom duration-1000 delay-300">
                            <div class="bg-[#00f2ff]/3 border-l-2 border-[#00f2ff] p-8 md:p-10 relative overflow-hidden group/profile">
                                <div class="absolute top-4 right-4 text-[7px] text-[#00f2ff]/20 font-mono">ID: MISSION_DEBRIEF_01</div>
                                <div class="absolute inset-0 pointer-events-none opacity-[0.03] bg-[linear-gradient(rgba(0,242,255,0.1)_50%,transparent_50%)] bg-[length:100%_4px] animate-scan"></div>
                                <div class="flex items-center gap-3 mb-6">
                                    <div class="w-2 h-2 bg-[#00f2ff] animate-pulse"></div>
                                    <div class="text-[9px] text-[#00f2ff] font-bold tracking-[0.4em] uppercase">
                                        Mission_Profile
                                    </div>
                                </div>
                                <p
                                    id="div-modal-desc"
                                    class="text-base md:text-lg text-white/90 leading-relaxed font-light italic"
                                >
                                </p>
                            </div>

                            <div id="div-modal-footer-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div id="div-modal-assigned-box" class="bg-[#00f2ff]/5 border border-[#00f2ff]/10 p-6 relative group/meta hover:bg-[#00f2ff]/10 transition-colors flex items-center gap-4">
                                    <div class="absolute top-0 left-0 w-1 h-full bg-[#00f2ff]/20 group-hover:bg-[#00f2ff] transition-colors"></div>
                                    <div class="w-12 h-12 rounded-full border border-[#00f2ff]/30 overflow-hidden bg-black/40 flex-shrink-0 cursor-help group/coord">
                                        <img id="div-modal-coord-img" src="" alt="Coordinator" class="w-full h-full object-cover opacity-80 mix-blend-screen hover:opacity-100 transition-all" />
                                    </div>
                                    <div class="flex-grow pl-2">
                                        <div id="div-modal-coord-label" class="text-[9px] opacity-40 uppercase mb-1 tracking-widest">
                                            Assigned Coordinator
                                        </div>
                                        <div
                                            id="div-modal-coord"
                                            class="text-lg text-white font-bold uppercase leading-tight"
                                        >
                                        </div>
                                    </div>
                                </div>
                                <div class="bg-[#00f2ff]/5 border border-[#00f2ff]/10 p-6 relative group/meta hover:bg-[#00f2ff]/10 transition-colors">
                                    <div class="absolute top-0 left-0 w-1 h-full bg-[#00f2ff]/20 group-hover:bg-[#00f2ff] transition-colors"></div>
                                    <div id="div-modal-lead-label" class="text-[9px] opacity-40 uppercase mb-2 tracking-widest">
                                        Coordinator
                                    </div>
                                    <div
                                        id="div-modal-lead"
                                        class="text-xl text-white font-bold uppercase"
                                    >
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Footer HUD Junk -->
                        <div class="pt-10 border-t border-[#00f2ff]/10 flex flex-wrap gap-10 text-[9px] font-mono opacity-30">
                            <div id="div-modal-auth">AUTH_ID: TK-DIV-XXXX</div>
                            <div>LOCATION: SMP_ABBS_SURAKARTA</div>
                            <div class="animate-pulse">ENCRYPTION: AES-256-ACTIVE</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Module 04: Progression System (Levels) -->
        <div class="lg:col-span-12">
            <div
                class="border border-[#00f2ff]/30 p-8 bg-[#001226]/60 relative"
            >
                <div
                    class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase"
                >
                    Module_04 // System_Level
                </div>

                <h3
                    class="text-center text-2xl font-black mb-10 tracking-[0.4em] text-white uppercase"
                >
                    // Ranking Hierarchy
                </h3>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4"
                >
                    {
                        [
                            {
                                lvl: "0x01",
                                name: "Explorer",
                                focus: "Dasar & Tools",
                                details: {
                                    focus: "Mempelajari dasar-dasar teknologi (coding, elektronika, dll) dan mengenal tools club.",
                                    activity:
                                        "Mengikuti kegiatan pembelajaran secara aktif.",
                                    competition:
                                        "Hanya Kompetisi Internal untuk melatih mental dan dasar teknis.",
                                    promotion:
                                        "Lulus Ujian Teori 'Basic Of Tech 101' dengan nilai >78%.",
                                },
                            },
                            {
                                lvl: "0x02",
                                name: "Builder",
                                focus: "Mini Projects",
                                details: {
                                    focus: "Mengerjakan mini project sesuai arahan dan memahami alur pembuatan proyek.",
                                    activity:
                                        "Mengikuti latihan rutin dan menyelesaikan task dengan baik.",
                                    competition:
                                        "Kompetisi Tingkat Lokal/Regional (antar sekolah atau tingkat kota).",
                                    promotion:
                                        "Berhasil menyelesaikan Latihan Rutin selama 2 bulan.",
                                },
                            },
                            {
                                lvl: "0x03",
                                name: "Engineer",
                                focus: "Advanced Systems",
                                details: {
                                    focus: "Upgrade project kompleks dan menggabungkan konsep software & hardware.",
                                    activity:
                                        "Problem solving mandiri dalam pengerjaan project.",
                                    competition:
                                        "Kompetisi Tingkat Provinsi atau Undangan Khusus.",
                                    promotion:
                                        "Lulus Ujian Lisan 'Advanced Tech 101'.",
                                },
                            },
                            {
                                lvl: "0x04",
                                name: "Inventor",
                                focus: "Original Innovation",
                                details: {
                                    focus: "Menciptakan proyek orisinal yang inovatif dan siap lomba.",
                                    activity:
                                        "Membimbing anggota level di bawahnya (menjadi mentor).",
                                    competition:
                                        "Garda terdepan untuk Kompetisi Tingkat Nasional dan Internasional.",
                                    promotion:
                                        "Menjadi perwakilan utama klub dalam ajang-ajang bergengsi.",
                                },
                            },
                        ].map((rank) => (
                            <div
                                class="level-card border border-[#00f2ff]/20 p-6 bg-[#001226] hover:border-[#00f2ff] transition-all group cursor-pointer relative overflow-hidden"
                                data-lvl={rank.lvl}
                                data-name={rank.name}
                                data-focus={rank.details.focus}
                                data-activity={rank.details.activity}
                                data-comp={rank.details.competition}
                                data-promo={rank.details.promotion}
                            >
                                <div class="absolute top-0 right-0 p-2 text-[8px] text-[#00f2ff] opacity-0 group-hover:opacity-40 transition-opacity uppercase tracking-widest">
                                    Click to Decrypt
                                </div>
                                <div class="text-4xl font-black text-[#00f2ff]/10 mb-2 group-hover:text-[#00f2ff]/30 transition-colors">
                                    {rank.lvl}
                                </div>
                                <div class="text-xl font-bold text-white mb-4 uppercase tracking-tighter group-hover:text-[#00f2ff] transition-colors">
                                    {rank.name}
                                </div>
                                <div class="border-t border-[#00f2ff]/10 pt-4">
                                    <div class="text-[8px] opacity-40 uppercase tracking-widest mb-1">
                                        Primary Focus
                                    </div>
