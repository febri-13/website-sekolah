                board.classList.remove("opacity-0");
            });
        }
    });

    // Header Toggle Logic
    const siteHeader = document.querySelector('header');
    const toggleHeader = (show: boolean) => {
        if (siteHeader) {
            if (show) siteHeader.classList.remove('hide-header');
            else siteHeader.classList.add('hide-header');
        }
    };

    // Level Modal Logic
    const modal = document.getElementById("level-modal");
    const closeBtn = document.getElementById("close-modal");
    const levelCards = document.querySelectorAll(".level-card");

    const modalLvlId = document.getElementById("modal-lvl-id");
    const modalName = document.getElementById("modal-name");
    const modalFocus = document.getElementById("modal-focus");
    const modalActivity = document.getElementById("modal-activity");
    const modalComp = document.getElementById("modal-comp");
    const modalPromo = document.getElementById("modal-promo");

    levelCards.forEach((card) => {
        card.addEventListener("click", () => {
            const data = (card as HTMLElement).dataset;

            // Populate Modal
            if (modalLvlId) modalLvlId.textContent = data.lvl || "";
            if (modalName) modalName.textContent = data.name || "";
            if (modalFocus) modalFocus.textContent = data.focus || "";
            if (modalActivity) modalActivity.textContent = data.activity || "";
            if (modalComp) modalComp.textContent = data.comp || "";
            if (modalPromo) modalPromo.textContent = data.promo || "";

            // Show Modal
            if (modal) {
                modal.classList.remove("hidden");
                toggleHeader(false); // Hide Header
                requestAnimationFrame(() => {
                    modal.classList.remove("opacity-0");
                });
            }
        });
    });

    if (closeBtn && modal) {
        closeBtn.addEventListener("click", () => {
            modal.classList.add("opacity-0");
            toggleHeader(true); // Show Header
            setTimeout(() => {
                modal.classList.add("hidden");
            }, 300);
        });

        // Close on backdrop click
        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                if (closeBtn) (closeBtn as HTMLElement).click();
            }
        });
    }

    // Division Modal Logic
    const divModal = document.getElementById("div-modal");
    const closeDivBtn = document.getElementById("close-div-modal");
    const divCards = document.querySelectorAll(".div-card");

    const divModalImg = document.getElementById("div-modal-img") as HTMLImageElement;
    const divModalName = document.getElementById("div-modal-name");
    const divModalSlogan = document.getElementById("div-modal-slogan");
    const divModalDesc = document.getElementById("div-modal-desc");
    const divModalCoord = document.getElementById("div-modal-coord");
    const divModalCoordLabel = document.getElementById("div-modal-coord-label");
    const divModalAssignedBox = document.getElementById("div-modal-assigned-box");
    const divModalFooterGrid = document.getElementById("div-modal-footer-grid");
    const divModalCoordImg = document.getElementById("div-modal-coord-img") as HTMLImageElement;
    const divModalLead = document.getElementById("div-modal-lead");
    const divModalLeadLabel = document.getElementById("div-modal-lead-label");
    const divModalTagLead = document.getElementById("div-modal-tag-lead");
    const divModalAuth = document.getElementById("div-modal-auth");

    divCards.forEach((card) => {
        card.addEventListener("click", () => {
            // Remove active class from all and add to this one
            divCards.forEach(c => c.classList.remove('active-modal-trigger'));
            card.classList.add('active-modal-trigger');

            const data = (card as HTMLElement).dataset;

            if (divModalName) divModalName.textContent = data.name || "";
            if (divModalSlogan)
                divModalSlogan.textContent = `"${data.slogan || ""}"`;
            if (divModalDesc) divModalDesc.textContent = data.desc || "";
            if (divModalCoord) divModalCoord.textContent = data.coord || "";
            if (divModalCoordLabel) divModalCoordLabel.textContent = data.coordLabel || "Assigned Coordinator";
            if (divModalLabel) divModalLabel.textContent = data.rankLabel || "SQUAD_LEADER_IDENTIFIED";
            if (divModalCoordImg) divModalCoordImg.src = data.coordImg || "/logo.png";
            
            // Set the second box to show Coordinator or Leader based on context
            if (divModalLead && divModalLeadLabel) {
                if (data.hideAssigned === "true") {
                    divModalLead.textContent = data.name || "";
                    divModalLeadLabel.textContent = "Coordinator";
                } else {
                    divModalLead.textContent = data.lead || "";
                    divModalLeadLabel.textContent = "Squad Leader";
                }
            }

            if (divModalTagLead) divModalTagLead.textContent = data.lead || "";
            if (divModalImg) divModalImg.src = data.img || "";

            if (divModalAssignedBox) {
                if (data.hideAssigned === "true") {
                    divModalAssignedBox.classList.add("hidden");
                    if (divModalFooterGrid) {
                        divModalFooterGrid.classList.remove("sm:grid-cols-2");
                        divModalFooterGrid.classList.add("sm:grid-cols-1", "max-w-md", "mx-auto");
                    }
                } else {
                    divModalAssignedBox.classList.remove("hidden");
                    if (divModalFooterGrid) {
                        divModalFooterGrid.classList.add("sm:grid-cols-2");
                        divModalFooterGrid.classList.remove("sm:grid-cols-1", "max-w-md", "mx-auto");
                    }
                }
            }

            if (divModalAuth) divModalAuth.textContent = `AUTH_ID: TK-DIV-${Math.floor(Math.random() * 9000 + 1000)}`;

            if (divModal) {
                divModal.classList.remove("hidden");
                toggleHeader(false); // Hide Header
                requestAnimationFrame(() => {
                    divModal.classList.remove("opacity-0");
                });
            }
        });
    });

    if (closeDivBtn && divModal) {
        closeDivBtn.addEventListener("click", () => {
            divModal.classList.add("opacity-0");
            toggleHeader(true); // Show Header
            setTimeout(() => {
                divModal.classList.add("hidden");
            }, 300);
        });

        divModal.addEventListener("click", (e) => {
            if (e.target === divModal) {
                if (closeDivBtn) (closeDivBtn as HTMLElement).click();
            }
        });
    }

    // Modal Image Swap Logic
    let originalMainImg = "";
    let originalMainName = "";
    let originalMainLabel = "";
    const divModalLabel = document.getElementById("div-modal-label");

    if (divModalCoordImg && divModalImg && divModalTagLead && divModalCoord && divModalLabel) {
        divModalCoordImg.addEventListener("mouseenter", () => {
            const data = (divModalCoordImg.closest('.div-modal-content') as any)?.dataset || {};
            // We need to find the active card's data. 
            // A better way: store current card data globally or on the modal
            const currentCard = document.querySelector('.div-card.active-modal-trigger') as HTMLElement;
            const cardData = currentCard ? currentCard.dataset : {};

            originalMainImg = divModalImg.src;
            originalMainName = divModalTagLead.textContent || "";
            originalMainLabel = divModalLabel.textContent || "";
            
            divModalImg.classList.add("opacity-0");
            divModalTagLead.classList.add("opacity-0");
            divModalLabel.classList.add("opacity-0");
            
            setTimeout(() => {
                divModalImg.src = divModalCoordImg.src;
                divModalTagLead.textContent = divModalCoord.textContent;
                divModalLabel.textContent = cardData.coordRankLabel || "COORDINATOR_IDENTIFIED";
                
                divModalImg.classList.remove("opacity-0");
                divModalTagLead.classList.remove("opacity-0");
                divModalLabel.classList.remove("opacity-0");
            }, 150);
        });

        divModalCoordImg.addEventListener("mouseleave", () => {
            divModalImg.classList.add("opacity-0");
            divModalTagLead.classList.add("opacity-0");
            divModalLabel.classList.add("opacity-0");
            
            setTimeout(() => {
                divModalImg.src = originalMainImg;
                divModalTagLead.textContent = originalMainName;
                divModalLabel.textContent = originalMainLabel;
                
                divModalImg.classList.remove("opacity-0");
                divModalTagLead.classList.remove("opacity-0");
                divModalLabel.classList.remove("opacity-0");
            }, 150);
        });
    }

    // Update Date
    const dateEl = document.getElementById("bp-date");
    if (dateEl) {
        const now = new Date();
        dateEl.textContent =
            now.getFullYear() +
            "." +
            String(now.getMonth() + 1).padStart(2, "0") +
            "." +
            String(now.getDate()).padStart(2, "0");
    }
</script>

<style>
    #blueprint-board {
        scrollbar-width: thin;
        scrollbar-color: #00f2ff transparent;
    }
    #blueprint-board::-webkit-scrollbar {
        width: 4px;
    }
    #blueprint-board::-webkit-scrollbar-track {
        background: transparent;
    }
    #blueprint-board::-webkit-scrollbar-thumb {
        background: #00f2ff;
        box-shadow: 0 0 10px #00f2ff;
    }

    .glow-text {
        text-shadow:
            0 0 15px rgba(0, 242, 255, 0.8),
            0 0 30px rgba(0, 242, 255, 0.4);
    }

    @keyframes scanning {
        0% {
            top: 0;
        }
        100% {
            top: 100%;
        }
    }
    .scanning-line {
        animation: scanning 8s linear infinite;
    }

    @keyframes load {
        0% {
            width: 0;
        }
        100% {
            width: 100%;
        }
    }
    .animate-load {
        animation: load 2s ease-out forwards;
    }

    @keyframes spin-slow {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    .animate-spin-slow {
        animation: spin-slow 60s linear infinite;
    }

    @keyframes spin-reverse {
        from {
            transform: rotate(360deg);
        }
        to {
            transform: rotate(0deg);
        }
    }
    .animate-spin-reverse {
        animation: spin-reverse 90s linear infinite;
    }
</style>
