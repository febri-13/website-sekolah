                                    <div class="text-[10px] text-[#00f2ff]/40 font-black tracking-[0.3em] uppercase">Classified</div>
                                    <div class="w-8 h-[1px] bg-[#00f2ff]/20 mt-1"></div>
                                </div>

                                <div class="info-real opacity-0 transition-opacity duration-500">
                                    <div class="absolute -inset-2 border border-[#00f2ff]/10 bg-[#001226]/40 -z-10"></div>
                                    <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-[#00f2ff]/30"></div>
                                    <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-[#00f2ff]/30"></div>

                                    <div class="relative overflow-hidden">
                                        <div class="bg-[#00f2ff] text-[#001226] px-4 py-1 text-[10px] font-black uppercase italic decrypt-text" data-text={organization.chairperson.role}>********</div>
                                        <div class="text-white font-bold mt-2 uppercase tracking-[0.3em] text-base decrypt-text" data-text={organization.chairperson.name}>[ REDACTED ]</div>
                                    </div>
                                </div>
                            </div>
                            <!-- Vertical line down -->
                            <div class="w-px h-16 bg-[#00f2ff]/50 mt-4"></div>
                        </div>
                        <div></div> <!-- Empty Col 3 -->
                    </div>

                    <!-- Row 3: Sekben Branching -->
                    <div class="grid grid-cols-3 gap-0 relative">
                        <!-- Bridging Connector: From Center Trunk to Sekben Photo -->
                        <div class="absolute top-[calc(50%+24px)] left-1/2 w-[calc(16.66%+48px)] h-px bg-[#00f2ff]/50 -translate-y-1/2 z-0"></div>

                        <!-- Empty (Col 1) -->
                        <div></div>

                        <!-- Trunk (Col 2) -->
                        <div class="flex flex-col items-center relative z-10">
                            <div class="w-px h-full bg-[#00f2ff]/50"></div>
                        </div>

                        <!-- Sekben (Col 3) -->
                        <div class="flex flex-col items-start relative pt-12 z-10">
                            <div class="flex items-center group relative ml-12 transition-all duration-300 hover:z-50">
                                <div 
                                    class="div-card is-classified w-28 h-36 border border-[#00f2ff]/30 relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] cursor-pointer hover:scale-110 transition-transform duration-300"
                                    data-name="Sekretaris & Bendahara"
                                    data-slogan="Administration & Finance"
                                    data-desc={organization.sekben.desc}
                                    data-coord={organization.sekben.koord_name}
                                    data-coord-label="Assigned Coordinator"
                                    data-rank-label={`SEKRETARIS & BENDAHARA: ${organization.sekben.name}`}
                                    data-coord-rank-label={`COORDINATOR: ${organization.sekben.koord_name}`}
                                    data-coord-img={organization.sekben.koord_img}
                                    data-lead={organization.sekben.name}
                                    data-img={organization.sekben.image}
                                >
                                    <div class="classified-content w-full h-full">
                                        <img src={organization.sekben.image} class="w-full h-full object-cover opacity-80 mix-blend-screen hover:opacity-100 group-hover:mix-blend-normal transition-all duration-500" style={(organization.sekben as any).added_style || ""} />
                                    </div>
                                    <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-2 z-20">
                                        <div class="text-[8px] text-[#00f2ff] font-black tracking-widest uppercase mb-1">Classified</div>
                                        <i data-feather="lock" class="w-4 h-4 text-[#00f2ff]/30"></i>
                                    </div>
                                    <div class="hex-reveal">
                                        {Array.from({ length: 20 }).map(() => (
                                            <div class="hex-cell">00</div>
                                        ))}
                                    </div>
                                </div>
                                <div class="ml-6 text-center reveal-info relative w-36 h-12 group/info">
                                    <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/20 flex items-center justify-center z-10 transition-all duration-500">
                                        <div class="text-[8px] text-[#00f2ff]/40 font-black tracking-widest uppercase">Classified</div>
                                    </div>
                                    <div class="info-real opacity-0 transition-opacity duration-500">
                                        <div class="absolute inset-0 border border-[#00f2ff]/10 bg-[#001226]/40 -z-10"></div>
                                        <div class="bg-[#00f2ff]/20 text-[#00f2ff] border border-[#00f2ff]/50 px-3 py-1 text-[8px] font-bold uppercase tracking-tighter inline-block decrypt-text" data-text={organization.sekben.role}>********</div>
                                        <div class="text-white font-bold mt-1 uppercase tracking-widest text-xs decrypt-text" data-text={organization.sekben.name}>[ REDACTED ]</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Transition to Kabids -->
                    <div class="grid grid-cols-3 gap-0">
                        <div></div>
                        <div class="flex flex-col items-center">
                            <div class="w-px h-16 bg-[#00f2ff]/50"></div>
                        </div>
                        <div></div>
                    </div>

                    <!-- Row 5: Kabid Layer -->
                    <div class="relative px-12 lg:px-24">
                        <!-- Horizontal Branching Line (Distributing) -->
                        <div class="w-full h-px bg-gradient-to-r from-transparent via-[#00f2ff]/50 to-transparent"></div>
                        
                        <div class="grid grid-cols-3 gap-4 pt-0">
                            {organization.kabids.map((kabid) => (
                                <div class="flex flex-col items-center group relative z-10 hover:z-50">
                                    <div class="w-px h-10 bg-[#00f2ff]/50 -mt-[1px] relative z-0"></div>
                                    <div 
                                        class="div-card is-classified w-28 h-36 border border-[#00f2ff]/20 relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] group-hover:border-[#00f2ff]/60 hover:scale-110 hover:shadow-[0_0_40px_rgba(0,242,255,0.2)] transition-all duration-300 cursor-pointer z-10"
                                        data-name={kabid.role.split("// ")[1] || kabid.role}
                                        data-slogan={kabid.slogan}
                                        data-desc={kabid.desc}
                                        data-coord={kabid.koord_name}
                                        data-coord-label="Assigned Coordinator"
                                        data-rank-label={`SQUAD LEADER: ${kabid.name}`}
                                        data-coord-rank-label={`COORDINATOR: ${kabid.koord_name}`}
                                        data-coord-img={kabid.koord_img}
                                        data-lead={kabid.name}
                                        data-img={kabid.image}
                                    >
                                        <div class="classified-content w-full h-full">
                                            <!-- Tactical Background 'Box' -->
                                            <div class="absolute inset-0 bg-[#00f2ff]/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                            <div class="absolute -inset-1 border border-[#00f2ff]/10 opacity-0 group-hover:opacity-100 transition-all scale-110 blur-sm"></div>
                                            
                                            <img src={kabid.image} class="w-full h-full object-cover opacity-70 mix-blend-screen group-hover:opacity-100 group-hover:mix-blend-normal transition-all duration-700" style={(kabid as any).added_style || ""} />
                                        </div>
                                        <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-2 z-20">
                                            <div class="text-[8px] text-[#00f2ff] font-black tracking-widest uppercase mb-1">Classified</div>
                                            <i data-feather="lock" class="w-4 h-4 text-[#00f2ff]/30"></i>
                                        </div>
                                    </div>
                                    <div class="mt-4 text-center reveal-info relative w-32 h-10 group/info">
                                        <!-- Classified Placeholder -->
                                        <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/20 flex items-center justify-center z-10 transition-all duration-500">
                                            <div class="text-[7px] text-[#00f2ff]/40 font-black tracking-[0.2em] uppercase">Classified</div>
                                        </div>
                                        
                                        <!-- Decrypted Content -->
                                        <div class="info-real opacity-0 transition-opacity duration-500">
                                            <div class="absolute inset-0 border border-[#00f2ff]/10 bg-[#001226]/40 -z-10"></div>
                                            <div class="text-[8px] text-[#00f2ff] opacity-50 uppercase mb-1 tracking-widest decrypt-text" data-text={kabid.role}>********</div>
                                            <div class="text-white font-bold uppercase text-[10px] decrypt-text" data-text={kabid.name}>[ REDACTED ]</div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- HUD Junk Details -->
                <div class="absolute bottom-4 right-4 text-[8px] font-mono text-[#00f2ff]/20 uppercase tracking-[0.5em] hidden md:block">
                    HEURISTIC_HIERARCHY_MAPPING_V4.1 // SECURE_ACCESS
                </div>
            </div>
        </div>
    </div>

    <!-- Floating HUD Decorations -->
    <div
        class="fixed top-1/4 -right-20 w-64 h-64 border border-[#00f2ff]/10 rounded-full pointer-events-none animate-spin-slow"
    >
    </div>
    <div
        class="fixed -bottom-20 -left-20 w-80 h-80 border border-[#00f2ff]/5 rounded-full pointer-events-none animate-spin-reverse"
    >
    </div>
</div>

<script>
    // Transition from CrtBoot
    window.addEventListener("boot-finished", () => {
        const board = document.getElementById("blueprint-board");
        if (board) {
            board.classList.remove("hidden");
            requestAnimationFrame(() => {
                board.classList.remove("opacity-0");
            });
        }
    });

    // Header Toggle Logic
    const siteHeader = document.querySelector('header');
    const toggleHeader = (show: boolean) => {
        if (siteHeader) {
            if (show) siteHeader.classList.remove('hide-header');
            else siteHeader.classList.add('hide-header');
        }
    };

    // Level Modal Logic
    const modal = document.getElementById("level-modal");
    const closeBtn = document.getElementById("close-modal");
    const levelCards = document.querySelectorAll(".level-card");

    const modalLvlId = document.getElementById("modal-lvl-id");
    const modalName = document.getElementById("modal-name");
    const modalFocus = document.getElementById("modal-focus");
    const modalActivity = document.getElementById("modal-activity");
    const modalComp = document.getElementById("modal-comp");
    const modalPromo = document.getElementById("modal-promo");

    levelCards.forEach((card) => {
        card.addEventListener("click", () => {
            const data = (card as HTMLElement).dataset;

            // Populate Modal
            if (modalLvlId) modalLvlId.textContent = data.lvl || "";
            if (modalName) modalName.textContent = data.name || "";
            if (modalFocus) modalFocus.textContent = data.focus || "";
            if (modalActivity) modalActivity.textContent = data.activity || "";
            if (modalComp) modalComp.textContent = data.comp || "";
            if (modalPromo) modalPromo.textContent = data.promo || "";

            // Show Modal
            if (modal) {
                modal.classList.remove("hidden");
                toggleHeader(false); // Hide Header
                requestAnimationFrame(() => {
                    modal.classList.remove("opacity-0");
                });
            }
        });
    });

    if (closeBtn && modal) {
        closeBtn.addEventListener("click", () => {
            modal.classList.add("opacity-0");
            toggleHeader(true); // Show Header
            setTimeout(() => {
                modal.classList.add("hidden");
            }, 300);
        });

        // Close on backdrop click
        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                if (closeBtn) (closeBtn as HTMLElement).click();
            }
        });
    }

    // Division Modal Logic
    const divModal = document.getElementById("div-modal");
    const closeDivBtn = document.getElementById("close-div-modal");
    const divCards = document.querySelectorAll(".div-card");

    const divModalImg = document.getElementById("div-modal-img") as HTMLImageElement;
    const divModalName = document.getElementById("div-modal-name");
    const divModalSlogan = document.getElementById("div-modal-slogan");
    const divModalDesc = document.getElementById("div-modal-desc");
    const divModalCoord = document.getElementById("div-modal-coord");
    const divModalCoordLabel = document.getElementById("div-modal-coord-label");
    const divModalAssignedBox = document.getElementById("div-modal-assigned-box");
    const divModalFooterGrid = document.getElementById("div-modal-footer-grid");
    const divModalCoordImg = document.getElementById("div-modal-coord-img") as HTMLImageElement;
    const divModalLead = document.getElementById("div-modal-lead");
    const divModalLeadLabel = document.getElementById("div-modal-lead-label");
    const divModalTagLead = document.getElementById("div-modal-tag-lead");
    const divModalAuth = document.getElementById("div-modal-auth");

    // Decryption Effect Function
    const decryptEffect = (el: HTMLElement, finalResult: string) => {
        const chars = "0123456789ABCDEF!@#$%^&*()_+";
        let iteration = 0;
        const interval = setInterval(() => {
            el.innerText = finalResult
                .split("")
                .map((char, index) => {
                    if (index < iteration) return finalResult[index];
                    return chars[Math.floor(Math.random() * chars.length)];
                })
                .join("");

            if (iteration >= finalResult.length) clearInterval(interval);
            iteration += 1 / 3;
        }, 30);
    };

    divCards.forEach((card) => {
        card.addEventListener("click", (e) => {
            if (card.classList.contains('is-classified')) {
                e.preventDefault();
                e.stopPropagation();
                
                card.classList.add('decrypting');
                const overlayText = card.querySelector('.classified-overlay div');
                if (overlayText) overlayText.textContent = "DECRYPTING...";
                
                // Animate hex cells
                const hexCells = card.querySelectorAll('.hex-cell');
                const hexInterval = setInterval(() => {
                    hexCells.forEach((cell: any) => {
                        cell.innerText = Math.floor(Math.random() * 256).toString(16).toUpperCase().padStart(2, '0');
                    });
                }, 50);

                // Trigger reveal
                setTimeout(() => {
                    clearInterval(hexInterval);
                    card.classList.remove('is-classified', 'decrypting');
                    card.classList.add('is-revealed');
                    
                    const info = card.parentElement?.querySelector('.reveal-info');
                    if (info) {
                        const placeholder = info.querySelector('.info-placeholder');
                        const real = info.querySelector('.info-real');
                        
                        if (placeholder) placeholder.classList.add('opacity-0', 'pointer-events-none');
                        if (real) real.classList.remove('opacity-0');
                        
                        info.querySelectorAll('.decrypt-text').forEach((textEl: any) => {
                            decryptEffect(textEl, textEl.dataset.text || "");
                        });
                    }
                }, 1000);
                
                return;
            }

            // Original Modal Logic
            // Remove active class from all and add to this one
            divCards.forEach(c => c.classList.remove('active-modal-trigger'));
            card.classList.add('active-modal-trigger');

            const data = (card as HTMLElement).dataset;

            if (divModalName) divModalName.textContent = data.name || "";
            if (divModalSlogan)
                divModalSlogan.textContent = `"${data.slogan || ""}"`;
            if (divModalDesc) divModalDesc.textContent = data.desc || "";
            if (divModalCoord) divModalCoord.textContent = data.coord || "";
            if (divModalCoordLabel) divModalCoordLabel.textContent = data.coordLabel || "Assigned Coordinator";
            if (divModalLabel) divModalLabel.textContent = data.rankLabel || "SQUAD_LEADER_IDENTIFIED";
            if (divModalCoordImg) divModalCoordImg.src = data.coordImg || "/logo.png";
            
            // Set the second box to show Coordinator or Leader based on context
            if (divModalLead && divModalLeadLabel) {
                if (data.hideAssigned === "true") {
                    divModalLead.textContent = data.name || "";
                    divModalLeadLabel.textContent = "Coordinator";
                } else {
                    divModalLead.textContent = data.lead || "";
                    divModalLeadLabel.textContent = "Squad Leader";
                }
            }

            if (divModalTagLead) divModalTagLead.textContent = data.lead || "";
            if (divModalImg) divModalImg.src = data.img || "";

            if (divModalAssignedBox) {
                if (data.hideAssigned === "true") {
                    divModalAssignedBox.classList.add("hidden");
                    if (divModalFooterGrid) {
                        divModalFooterGrid.classList.remove("sm:grid-cols-2");
                        divModalFooterGrid.classList.add("sm:grid-cols-1", "max-w-md", "mx-auto");
                    }
                } else {
                    divModalAssignedBox.classList.remove("hidden");
                    if (divModalFooterGrid) {
                        divModalFooterGrid.classList.add("sm:grid-cols-2");
                        divModalFooterGrid.classList.remove("sm:grid-cols-1", "max-w-md", "mx-auto");
                    }
                }
            }

            if (divModalAuth) divModalAuth.textContent = `AUTH_ID: TK-DIV-${Math.floor(Math.random() * 9000 + 1000)}`;

            if (divModal) {
                divModal.classList.remove("hidden");
                toggleHeader(false); // Hide Header
                requestAnimationFrame(() => {
                    divModal.classList.remove("opacity-0");
                });
            }
        });
    });

    if (closeDivBtn && divModal) {
        closeDivBtn.addEventListener("click", () => {
            divModal.classList.add("opacity-0");
            toggleHeader(true); // Show Header
            setTimeout(() => {
                divModal.classList.add("hidden");
            }, 300);
        });

        divModal.addEventListener("click", (e) => {
            if (e.target === divModal) {
                if (closeDivBtn) (closeDivBtn as HTMLElement).click();
            }
        });
    }

    // Modal Image Swap Logic
    let originalMainImg = "";
    let originalMainName = "";
    let originalMainLabel = "";
    const divModalLabel = document.getElementById("div-modal-label");

    if (divModalCoordImg && divModalImg && divModalTagLead && divModalCoord && divModalLabel) {
        divModalCoordImg.addEventListener("mouseenter", () => {
            const data = (divModalCoordImg.closest('.div-modal-content') as any)?.dataset || {};
            // We need to find the active card's data. 
            // A better way: store current card data globally or on the modal
            const currentCard = document.querySelector('.div-card.active-modal-trigger') as HTMLElement;
            const cardData = currentCard ? currentCard.dataset : {};

            originalMainImg = divModalImg.src;
            originalMainName = divModalTagLead.textContent || "";
            originalMainLabel = divModalLabel.textContent || "";
            
            divModalImg.classList.add("opacity-0");
            divModalTagLead.classList.add("opacity-0");
            divModalLabel.classList.add("opacity-0");
            
            setTimeout(() => {
                divModalImg.src = divModalCoordImg.src;
                divModalTagLead.textContent = divModalCoord.textContent;
                divModalLabel.textContent = cardData.coordRankLabel || "COORDINATOR_IDENTIFIED";
                
                divModalImg.classList.remove("opacity-0");
                divModalTagLead.classList.remove("opacity-0");
                divModalLabel.classList.remove("opacity-0");
            }, 150);
        });

        divModalCoordImg.addEventListener("mouseleave", () => {
            divModalImg.classList.add("opacity-0");
            divModalTagLead.classList.add("opacity-0");
            divModalLabel.classList.add("opacity-0");
            
            setTimeout(() => {
                divModalImg.src = originalMainImg;
                divModalTagLead.textContent = originalMainName;
                divModalLabel.textContent = originalMainLabel;
                
                divModalImg.classList.remove("opacity-0");
                divModalTagLead.classList.remove("opacity-0");
                divModalLabel.classList.remove("opacity-0");
            }, 150);
        });
    }

    // Hierarchy Access Terminal Logic
    const btnInitiate = document.getElementById("btn-initiate-access");
    const terminalAccess = document.getElementById("terminal-access");
    const terminalCommand = document.getElementById("terminal-command");
    const terminalOutput = document.getElementById("terminal-output");
    const hierarchyContent = document.getElementById("hierarchy-real-content");
    const hierarchyCollapsed = document.getElementById("hierarchy-collapsed");
    const hierarchyContainer = document.getElementById("hierarchy-container");

    if (btnInitiate && terminalAccess && terminalCommand && terminalOutput && hierarchyContent && hierarchyCollapsed && hierarchyContainer) {
        btnInitiate.addEventListener("click", () => {
            // Step 1: Collapse the initial button and expand container
            hierarchyCollapsed.classList.add("hidden");
            hierarchyContainer.classList.remove("min-h-[100px]");
            hierarchyContainer.classList.add("min-h-[400px]");
            
            // Step 2: Show Terminal
            terminalAccess.classList.remove("opacity-0", "pointer-events-none");

            const command = "abbs-cli access --community=\"The Tinkers\"";
            let cmdIdx = 0;

            const typeCommand = setInterval(() => {
                terminalCommand.textContent += command[cmdIdx];
                cmdIdx++;
                if (cmdIdx >= command.length) {
                    clearInterval(typeCommand);
                    startLogSequence();
                }
            }, 50);

            const startLogSequence = () => {
                const logs = [
                    { t: "[SYSTEM] Initializing handshake...", d: 500 },
                    { t: "[OK] Encryption keys received.", d: 300 },
                    { t: "[SYSTEM] Bypassing firewall...", d: 700 },
                    { t: "[OK] Root access established.", d: 400 },
                    { t: "[SYSTEM] Decrypting organization.json...", d: 800 },
                    { t: "[WARN] Integrity check bypass successful.", d: 300 },
                    { t: "[OK] Visualizing structure...", d: 400 },
                    { t: ">> ACCESS GRANTED <<", d: 1000, color: "text-green-400 font-black" }
                ];

                let logIdx = 0;
                const addLog = () => {
                    if (logIdx >= logs.length) {
                        setTimeout(revealHierarchy, 500);
                        return;
                    }

                    const log = logs[logIdx];
                    const div = document.createElement("div");
                    div.className = `opacity-0 transition-opacity duration-300 ${log.color || ""}`;
                    div.textContent = log.t;
                    terminalOutput.appendChild(div);
                    
                    // Auto scroll
                    terminalOutput.scrollTop = terminalOutput.scrollHeight;

                    requestAnimationFrame(() => div.classList.remove("opacity-0"));

                    logIdx++;
                    setTimeout(addLog, log.d);
                };

                setTimeout(addLog, 500);
            };

            const revealHierarchy = () => {
                terminalAccess.classList.add("opacity-0", "scale-110", "pointer-events-none");
                hierarchyContent.classList.remove("hidden");
                
                // Allow browser to register 'hidden' removal before animating opacity
                requestAnimationFrame(() => {
                    hierarchyContent.classList.remove("opacity-0", "pointer-events-none", "scale-95", "blur-md");
                    hierarchyContainer.style.minHeight = "auto";
                });
                
                setTimeout(() => {
                    terminalAccess.classList.add("hidden");
                }, 700);
            };
        });
    }

    // Update Date
    const dateEl = document.getElementById("bp-date");
    if (dateEl) {
        const now = new Date();
        dateEl.textContent =
            now.getFullYear() +
            "." +
            String(now.getMonth() + 1).padStart(2, "0") +
            "." +
            String(now.getDate()).padStart(2, "0");
    }
</script>

<style>
    #blueprint-board {
        scrollbar-width: thin;
        scrollbar-color: #00f2ff transparent;
    }
    #blueprint-board::-webkit-scrollbar {
        width: 4px;
    }
    #blueprint-board::-webkit-scrollbar-track {
        background: transparent;
    }
    #blueprint-board::-webkit-scrollbar-thumb {
        background: #00f2ff;
        box-shadow: 0 0 10px #00f2ff;
    }

    .glow-text {
        text-shadow:
            0 0 15px rgba(0, 242, 255, 0.8),
            0 0 30px rgba(0, 242, 255, 0.4);
    }

    @keyframes scanning {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(100%); }
    }
    .scanning-line {
        animation: scanning 8s linear infinite;
        will-change: transform;
    }

    @keyframes load {
        0% {
            width: 0;
        }
        100% {
            width: 100%;
        }
    }
    .animate-load {
        animation: load 2s ease-out forwards;
    }

    @keyframes spin-slow {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    .animate-spin-slow {
        animation: spin-slow 60s linear infinite;
        will-change: transform;
        transform: translateZ(0);
    }

    @keyframes spin-reverse {
        from { transform: rotate(360deg); }
        to { transform: rotate(0deg); }
    }
    .animate-spin-reverse {
        animation: spin-reverse 90s linear infinite;
        will-change: transform;
        transform: translateZ(0);
    }

    /* Classified Effects */
    .classified-overlay {
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .is-revealed .classified-overlay {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.1) translateZ(0);
        filter: blur(10px);
    }

    .is-revealed .classified-content {
        filter: none;
        opacity: 1;
        transform: translateZ(0);
    }

    .classified-content {
        transition: all 0.8s ease;
        filter: blur(20px) brightness(0);
        opacity: 0;
        transform: translateZ(0);
        will-change: filter, opacity, transform;
    }

    .is-revealed .classified-content {
        filter: blur(0) brightness(1);
