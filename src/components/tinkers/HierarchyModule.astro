---
interface Props {
  organization: any;
}

const { organization } = Astro.props;
---

<div class="lg:col-span-12 mt-12 transition-all duration-700 ease-in-out" id="hierarchy-module">
    <div class="border border-[#00f2ff]/30 bg-[#001226]/60 backdrop-blur-md relative overflow-hidden min-h-[100px] flex items-center justify-center transition-all duration-700" id="hierarchy-container">
        
        <!-- Initial Access Button (Collapsed State) -->
        <div id="hierarchy-collapsed" class="py-12 flex flex-col items-center gap-6 z-[110]">
            <div class="flex items-center gap-4">
                <div class="h-px w-8 bg-gradient-to-r from-transparent to-[#00f2ff]/50"></div>
                <div class="text-[10px] text-[#00f2ff] tracking-[0.6em] uppercase font-black animate-pulse">Security protocol 07 active</div>
                <div class="h-px w-8 bg-gradient-to-l from-transparent to-[#00f2ff]/50"></div>
            </div>

            <button 
                id="btn-initiate-access" 
                class="tactical-btn group relative px-16 py-6 bg-transparent text-[#00f2ff] font-black uppercase tracking-[0.6em] transition-all duration-500"
            >
                <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-[#00f2ff] group-hover:w-full group-hover:h-full transition-all duration-500"></div>
                <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-[#00f2ff] group-hover:w-full group-hover:h-full transition-all duration-500"></div>
                <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-[#00f2ff] group-hover:w-full group-hover:h-full transition-all duration-500"></div>
                <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-[#00f2ff] group-hover:w-full group-hover:h-full transition-all duration-500"></div>
                
                <div class="absolute inset-1 bg-[#00f2ff]/5 group-hover:bg-[#00f2ff]/20 transition-colors duration-500"></div>
                
                <div class="absolute inset-0 overflow-hidden">
                    <div class="w-full h-[2px] bg-[#00f2ff] opacity-50 shadow-[0_0_15px_#00f2ff] absolute -top-full animate-scan-fast"></div>
                </div>

                <span class="relative z-10 group-hover:tracking-[0.8em] transition-all duration-500 glow-text">Access Hierarchy</span>
            </button>

            <div class="flex flex-col items-center gap-2">
                <div class="flex gap-1">
                    <div class="w-1 h-3 bg-red-500/20"></div>
                    <div class="w-1 h-3 bg-red-500/40"></div>
                    <div class="w-1 h-3 bg-red-500 animate-pulse"></div>
                </div>
                <span class="text-[9px] text-red-500 font-mono tracking-widest uppercase">System Restricted // Authorized Personnel Only</span>
            </div>
        </div>

        <!-- Terminal Access Overlay -->
        <div id="terminal-access" class="absolute inset-0 bg-[#000a12] z-[100] flex flex-col items-center justify-center p-8 transition-all duration-700 opacity-0 pointer-events-none">
            <div class="w-full max-w-xl bg-black/80 border border-[#00f2ff]/20 p-6 font-mono text-[11px] shadow-[0_0_50px_rgba(0,242,255,0.05)] relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#00f2ff]/30 to-transparent"></div>
                
                <div id="terminal-output" class="space-y-1 text-[#00f2ff] h-40 overflow-hidden">
                    <div class="opacity-70 text-[9px] mb-4 uppercase tracking-[0.3em]">-- TINKERS_OS V4.1 SECURITY_KERNEL --</div>
                    <div class="flex gap-2">
                        <span class="text-green-500">root@tinkers-hq:~$</span>
                        <span id="terminal-command"></span><span class="animate-pulse">_</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="hierarchy-real-content" class="w-full p-12 opacity-0 pointer-events-none transition-all duration-1000 scale-95 blur-md hidden">
            <div class="absolute -top-px -left-px bg-[#00f2ff] text-[#001226] px-3 py-1 text-[10px] font-bold uppercase tracking-widest">
                Module_07 // CLASSIFIED_ORGANIZATION
            </div>

            <div class="absolute inset-0 pointer-events-none opacity-5">
                <div class="absolute inset-0" style="background-image: radial-gradient(#00f2ff 1px, transparent 1px); background-size: 40px 40px;"></div>
            </div>
            
            <h3 class="text-center text-3xl font-black mb-20 tracking-[0.4em] text-white uppercase glow-text relative z-10">
                // Core Command Unit
            </h3>

            <!-- Grid-Based Tree System -->
            <div class="relative z-10 max-w-6xl mx-auto font-mono">
                <!-- Row 1: Coordinator Layer -->
                <div class="relative px-12 lg:px-24 mb-0">
                    <div class="grid grid-cols-3 gap-4">
                        {organization.kabids.map((kabid: any) => (
                            <div class="flex flex-col items-center group relative z-10 hover:z-50">
                                <div 
                                    class="div-card is-classified w-24 h-32 border border-[#00f2ff]/40 relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] group-hover:border-[#00f2ff] hover:scale-110 transition-all duration-300 cursor-pointer"
                                    data-name={kabid.koord_name}
                                    data-slogan="Expert Technical Advisor"
                                    data-desc={`As the Coordinator for ${kabid.role.split("// ")[1] || kabid.role}, ${kabid.koord_name} provides essential technical mentorship and strategic oversight.`}
                                    data-coord={kabid.koord_name}
                                    data-hide-assigned="true"
                                    data-rank-label={`COORDINATOR: ${kabid.koord_name}`}
                                    data-lead={kabid.koord_name}
                                    data-img={kabid.koord_img}
                                    data-coord-img={kabid.image}
                                >
                                    <div class="classified-content w-full h-full">
                                        <img src={kabid.koord_img} class="w-full h-full object-cover opacity-60 mix-blend-screen grayscale hover:grayscale-0 hover:opacity-100 group-hover:mix-blend-normal transition-all duration-500" style={kabid.added_style_koord || ""} />
                                        <div class="absolute top-0 left-0 bg-[#00f2ff]/20 px-1 text-[6px] text-[#00f2ff] font-bold">ADVISOR</div>
                                    </div>
                                    <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-2 z-20">
                                        <div class="text-[6px] text-[#00f2ff] font-black tracking-widest uppercase mb-1">Classified</div>
                                        <div class="w-3 h-3 border border-[#00f2ff]/40 flex items-center justify-center">L</div>
                                    </div>
                                    <div class="hex-reveal">
                                        {Array.from({ length: 20 }).map(() => (
                                            <div class="hex-cell">00</div>
                                        ))}
                                    </div>
                                </div>
                                <div class="mt-2 text-center reveal-info relative w-24 h-8 group/info">
                                    <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/20 flex items-center justify-center z-10 transition-all duration-500">
                                        <div class="text-[5px] text-[#00f2ff]/40 font-black tracking-widest uppercase">Classified</div>
                                    </div>
                                    <div class="info-real opacity-0 transition-opacity duration-500">
                                        <div class="text-[7px] text-[#00f2ff] opacity-40 uppercase tracking-widest decrypt-text" data-text="COORDINATOR">********</div>
                                        <div class="text-white/80 font-bold uppercase text-[9px] decrypt-text" data-text={kabid.koord_name}>[ REDACTED ]</div>
                                    </div>
                                </div>
                                <div class="w-px h-10 bg-[#00f2ff]/30 mt-2"></div>
                            </div>
                        ))}
                    </div>
                    <div class="w-full h-px bg-gradient-to-r from-transparent via-[#00f2ff]/50 to-transparent"></div>
                </div>

                <!-- Row 2: Chairperson -->
                <div class="grid grid-cols-3 gap-4 mb-0 mt-0">
                    <div></div>
                    <div class="flex flex-col items-center relative z-10 hover:z-50">
                        <div class="w-px h-16 bg-[#00f2ff]/50 -mt-[1px] mb-0 relative z-0"></div>
                        <div 
                            class="div-card is-classified w-44 h-56 border-2 border-[#00f2ff] relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] shadow-[0_0_30px_rgba(0,242,255,0.1)] group cursor-pointer hover:scale-105 transition-transform duration-300 z-10"
                            data-name={organization.chairperson.role}
                            data-slogan="Chief Executive Officer"
                            data-desc={organization.chairperson.desc}
                            data-coord={organization.chairperson.koord_name}
                            data-coord-label="Assigned Coordinator"
                            data-rank-label={`CHAIRPERSON: ${organization.chairperson.name}`}
                            data-coord-rank-label={`COORDINATOR: ${organization.chairperson.koord_name}`}
                            data-coord-img={organization.chairperson.koord_img}
                            data-lead={organization.chairperson.name}
                            data-img={organization.chairperson.image}
                        >
                            <div class="classified-content w-full h-full">
                                <img src={organization.chairperson.image} class="w-full h-full object-cover opacity-80 mix-blend-screen hover:opacity-100 group-hover:mix-blend-normal transition-all duration-500 hover:scale-105" style={organization.chairperson.added_style || ""} />
                            </div>
                            <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-4 z-20">
                                <div class="text-[12px] text-[#00f2ff] font-black tracking-[0.4em] uppercase mb-2 glow-text">Classified</div>
                                <div class="w-8 h-8 border border-[#00f2ff]/30 flex items-center justify-center">L</div>
                            </div>
                            <div class="hex-reveal">
                                {Array.from({ length: 20 }).map(() => (
                                    <div class="hex-cell">00</div>
                                ))}
                            </div>
                        </div>
                        <div class="mt-4 text-center reveal-info relative w-44 h-16 group/info">
                            <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/30 flex flex-col items-center justify-center z-10 transition-all duration-500">
                                <div class="text-[10px] text-[#00f2ff]/40 font-black tracking-[0.3em] uppercase">Classified</div>
                            </div>
                            <div class="info-real opacity-0 transition-opacity duration-500">
                                <div class="bg-[#00f2ff] text-[#001226] px-4 py-1 text-[10px] font-black uppercase italic decrypt-text" data-text={organization.chairperson.role}>********</div>
                                <div class="text-white font-bold mt-2 uppercase tracking-[0.3em] text-base decrypt-text" data-text={organization.chairperson.name}>[ REDACTED ]</div>
                            </div>
                        </div>
                        <div class="w-px h-16 bg-[#00f2ff]/50 mt-4"></div>
                    </div>
                    <div></div>
                </div>

                <!-- Row 3: Sekben Branching -->
                <div class="grid grid-cols-3 gap-0 relative">
                    <div class="absolute top-[calc(50%+24px)] left-1/2 w-[calc(16.66%+48px)] h-px bg-[#00f2ff]/50 -translate-y-1/2 z-0"></div>
                    <div></div>
                    <div class="flex flex-col items-center relative z-10">
                        <div class="w-px h-full bg-[#00f2ff]/50"></div>
                    </div>
                    <div class="flex flex-col items-start relative pt-12 z-10">
                        <div class="flex items-center group relative ml-12 transition-all duration-300 hover:z-50">
                            <div 
                                class="div-card is-classified w-28 h-36 border border-[#00f2ff]/30 relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] cursor-pointer hover:scale-110 transition-transform duration-300"
                                data-name="Sekretaris & Bendahara"
                                data-slogan="Administration & Finance"
                                data-desc={organization.sekben.desc}
                                data-coord={organization.sekben.koord_name}
                                data-coord-label="Assigned Coordinator"
                                data-rank-label={`SEKRETARIS & BENDAHARA: ${organization.sekben.name}`}
                                data-coord-rank-label={`COORDINATOR: ${organization.sekben.koord_name}`}
                                data-coord-img={organization.sekben.koord_img}
                                data-lead={organization.sekben.name}
                                data-img={organization.sekben.image}
                            >
                                <div class="classified-content w-full h-full">
                                    <img src={organization.sekben.image} class="w-full h-full object-cover opacity-80 mix-blend-screen hover:opacity-100 group-hover:mix-blend-normal transition-all duration-500" style={organization.sekben.added_style || ""} />
                                </div>
                                <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-2 z-20">
                                    <div class="text-[8px] text-[#00f2ff] font-black tracking-widest uppercase mb-1">Classified</div>
                                    <div class="w-4 h-4 border border-[#00f2ff]/30 flex items-center justify-center">L</div>
                                </div>
                                <div class="hex-reveal">
                                    {Array.from({ length: 20 }).map(() => (
                                        <div class="hex-cell">00</div>
                                    ))}
                                </div>
                            </div>
                            <div class="ml-6 text-center reveal-info relative w-36 h-12 group/info">
                                <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/20 flex items-center justify-center z-10 transition-all duration-500">
                                    <div class="text-[8px] text-[#00f2ff]/40 font-black tracking-widest uppercase">Classified</div>
                                </div>
                                <div class="info-real opacity-0 transition-opacity duration-500">
                                    <div class="bg-[#00f2ff]/20 text-[#00f2ff] border border-[#00f2ff]/50 px-3 py-1 text-[8px] font-bold uppercase tracking-tighter inline-block decrypt-text" data-text={organization.sekben.role}>********</div>
                                    <div class="text-white font-bold mt-1 uppercase tracking-widest text-xs decrypt-text" data-text={organization.sekben.name}>[ REDACTED ]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 4: Transition to Kabids -->
                <div class="grid grid-cols-3 gap-0">
                    <div></div>
                    <div class="flex flex-col items-center">
                        <div class="w-px h-16 bg-[#00f2ff]/50"></div>
                    </div>
                    <div></div>
                </div>

                <!-- Row 5: Kabid Layer -->
                <div class="relative px-12 lg:px-24">
                    <div class="w-full h-px bg-gradient-to-r from-transparent via-[#00f2ff]/50 to-transparent"></div>
                    <div class="grid grid-cols-3 gap-4 pt-0">
                        {organization.kabids.map((kabid: any) => (
                            <div class="flex flex-col items-center group relative z-10 hover:z-50">
                                <div class="w-px h-10 bg-[#00f2ff]/50 -mt-[1px] relative z-0"></div>
                                <div 
                                    class="div-card is-classified w-28 h-36 border border-[#00f2ff]/20 relative overflow-hidden bg-[#001226]/40 group-hover:bg-[#001226] group-hover:border-[#00f2ff]/60 hover:scale-110 hover:shadow-[0_0_40px_rgba(0,242,255,0.2)] transition-all duration-300 cursor-pointer z-10"
                                    data-name={kabid.role.split("// ")[1] || kabid.role}
                                    data-slogan={kabid.slogan}
                                    data-desc={kabid.desc}
                                    data-coord={kabid.koord_name}
                                    data-coord-label="Assigned Coordinator"
                                    data-rank-label={`SQUAD LEADER: ${kabid.name}`}
                                    data-coord-rank-label={`COORDINATOR: ${kabid.koord_name}`}
                                    data-coord-img={kabid.koord_img}
                                    data-lead={kabid.name}
                                    data-img={kabid.image}
                                >
                                    <div class="classified-content w-full h-full">
                                        <img src={kabid.image} class="w-full h-full object-cover opacity-70 mix-blend-screen group-hover:opacity-100 group-hover:mix-blend-normal transition-all duration-700" style={kabid.added_style || ""} />
                                    </div>
                                    <div class="classified-overlay absolute inset-0 bg-[#001226] flex flex-col items-center justify-center p-2 z-20">
                                        <div class="text-[8px] text-[#00f2ff] font-black tracking-widest uppercase mb-1">Classified</div>
                                        <div class="w-4 h-4 border border-[#00f2ff]/30 flex items-center justify-center">L</div>
                                    </div>
                                </div>
                                <div class="mt-4 text-center reveal-info relative w-32 h-10 group/info">
                                    <div class="info-placeholder absolute inset-0 bg-[#001226] border border-[#00f2ff]/20 flex items-center justify-center z-10 transition-all duration-500">
                                        <div class="text-[7px] text-[#00f2ff]/40 font-black tracking-[0.2em] uppercase">Classified</div>
                                    </div>
                                    <div class="info-real opacity-0 transition-opacity duration-500">
                                        <div class="text-[8px] text-[#00f2ff] opacity-50 uppercase mb-1 tracking-widest decrypt-text" data-text={kabid.role}>********</div>
                                        <div class="text-white font-bold uppercase text-[10px] decrypt-text" data-text={kabid.name}>[ REDACTED ]</div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glow-text {
        text-shadow: 0 0 15px rgba(0, 242, 255, 0.8), 0 0 30px rgba(0, 242, 255, 0.4);
    }
    @keyframes scan-fast {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(200%); }
    }
    .animate-scan-fast {
        animation: scan-fast 3s linear infinite;
    }
    .hex-reveal {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(5, 1fr);
        gap: 1px;
        z-index: 15;
        pointer-events: none;
    }
    .hex-cell {
        background: #001226;
        color: #00f2ff;
        font-size: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .decrypting .hex-cell {
        opacity: 0.8;
    }
    .is-revealed .classified-overlay {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.1);
        filter: blur(10px);
    }
    .classified-content {
        transition: all 0.8s ease;
        filter: blur(20px) brightness(0);
        opacity: 0;
    }
    .is-revealed .classified-content {
        filter: blur(0) brightness(1);
        opacity: 1;
    }
</style>
