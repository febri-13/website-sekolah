---
// src/layouts/Layout.astro
import "../styles/global.css";
import HeaderSection from "../components/Layouts/HeaderSection.astro";
import FooterSection from "../components/Layouts/FooterSection.astro";

interface Props {
    title?: string;
}

const { title = "SMP ABBS Surakarta" } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="icon" type="image/png" sizes="any" href="/abbs_logos/favicon.png" />
        <link rel="apple-touch-icon" href="/abbs_logos/favicon.png" />
    </head>
    <body
        class="min-h-screen bg-[#fafaf9] text-gray-900 dark:bg-[#0a0a0a] dark:text-gray-100 selection:bg-primary-500/30 selection:text-primary-900 dark:selection:text-primary-100 transition-colors duration-300"
    >
        <HeaderSection />

        <main>
            <slot />
        </main>

        <FooterSection />

        <script>
            // Premium scroll reveal observer - handles all reveal classes
            const observerOptions = {
                threshold: 0.08,
                rootMargin: '0px 0px -60px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, observerOptions);

            const observeAll = () => {
                const reveals = document.querySelectorAll(
                    '.reveal, .reveal-up, .reveal-fade, .reveal-scale-up, .reveal-left, .reveal-right'
                );
                reveals.forEach(el => observer.observe(el));
            };

            document.addEventListener('DOMContentLoaded', observeAll);
            document.addEventListener('astro:page-load', observeAll);
        </script>

        <script>
            import feather from "feather-icons";

            const replaceIcons = () => {
                if (feather && feather.replace) {
                    feather.replace();
                }
            };

            replaceIcons();
            document.addEventListener('astro:page-load', replaceIcons);
        </script>

        <script>
            // Magnetic button effect
            document.addEventListener('DOMContentLoaded', () => {
                const magnetics = document.querySelectorAll('.magnetic');
                magnetics.forEach((el) => {
                    el.addEventListener('mousemove', (e) => {
                        const rect = (el as HTMLElement).getBoundingClientRect();
                        const x = e.clientX - rect.left - rect.width / 2;
                        const y = e.clientY - rect.top - rect.height / 2;
                        (el as HTMLElement).style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
                    });
                    el.addEventListener('mouseleave', () => {
                        (el as HTMLElement).style.transform = 'translate(0, 0)';
                    });
                });
            });
        </script>
    </body>
</html>

