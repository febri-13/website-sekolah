---
// src/pages/komunitas/meca_knights.astro
import Layout from "../../layouts/Layout.astro";
import MecaBackground from "../../components/mecaknights/MecaBackground.astro";
import MecaHero from "../../components/mecaknights/MecaHero.astro";
import MecaPrinciples from "../../components/mecaknights/MecaPrinciples.astro";
import MecaTriBakti from "../../components/mecaknights/MecaTriBakti.astro";
import MecaHierarchy from "../../components/mecaknights/MecaHierarchy.astro";
---

<Layout title="Meca Knights - PMR SMP ABBS Surakarta">
    <div class="meca-knights-wrapper relative min-h-screen overflow-x-hidden bg-[#050505] text-white selection:bg-red-600/30">
        <!-- Cosmic Animated Background -->
        <MecaBackground />

        <!-- Content -->
        <div class="relative z-10 container mx-auto px-6 py-20">
            <!-- Hero Header Section -->
            <MecaHero />

            <!-- 7 Principles of Red Cross Section -->
            <MecaPrinciples />

            <!-- Tri Bakti PMR Section -->
            <MecaTriBakti />

            <!-- Interactive Hierarchy Section -->
            <MecaHierarchy />
        </div>
    </div>
</Layout>

<style is:global>
    @import "@fontsource/outfit/700.css";
    @import "@fontsource/inter/300.css";
    @import "@fontsource/inter/400.css";
    @import "@fontsource/inter/700.css";
    @import "@fontsource/inter/900.css";

    main {
        padding: 0 !important;
    }
</style>
