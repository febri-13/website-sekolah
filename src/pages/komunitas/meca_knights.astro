---

<Layout title="Meca Knights / PMR - SMP ABBS Surakarta">
  <main class="min-h-screen bg-white overflow-x-hidden relative pb-[100vh]">
    <!-- Medical Grid Background -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.03] z-0" style="background-image: radial-gradient(#ef4444 0.5px, transparent 0.5px); background-size: 24px 24px;"></div>
    <div class="fixed inset-0 pointer-events-none opacity-[0.02] z-0" style="background-image: linear-gradient(#ef4444 1px, transparent 1px), linear-gradient(90deg, #ef4444 1px, transparent 1px); background-size: 120px 120px;"></div>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 flex flex-col items-center justify-center z-20">
        <div class="text-center mb-16 space-y-4" id="page-header">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 border border-red-100 text-red-600 text-[10px] font-bold tracking-widest uppercase mb-4">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"></span>
                </span>
                Operational Unit
            </div>
            <h1 class="text-6xl md:text-8xl font-black text-gray-900 tracking-tighter flex flex-col md:flex-row items-center justify-center gap-2 md:gap-4">
              <span>MECA</span>
              <span class="text-red-600 flex items-center">
                KNIGHTS
                <svg class="w-12 h-12 md:w-16 md:h-16 ml-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="currentColor"/>
                </svg>
              </span>
            </h1>
            <p class="text-sm md:text-base text-gray-400 font-bold tracking-[0.4em] uppercase max-w-2xl mx-auto leading-relaxed">
                Palang Merah Remaja - Madya - SMP ABBS Surakarta
            </p>
        </div>

        <!-- Refined Medical Box -->
        <div id="medical-box-container" class="relative w-48 h-32 cursor-pointer group transition-all duration-700 hover:scale-105 z-50">
            <!-- Box Lid -->
            <div id="box-lid" class="absolute inset-0 bg-white rounded-t-xl border-b-[6px] border-gray-100 origin-top transition-transform duration-[1500ms] cubic-bezier(0.4, 0, 0.2, 1) z-30 flex items-center justify-center border-x-2 border-t-2 shadow-xl shadow-red-900/5">
                <div class="w-14 h-14 bg-red-600 rounded-lg flex items-center justify-center shadow-lg relative overflow-hidden group-hover:bg-red-500 transition-colors">
                    <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <div class="absolute w-8 h-2 bg-white rounded-full"></div>
                    <div class="absolute w-2 h-8 bg-white rounded-full"></div>
                </div>
                <!-- Box Handle -->
                <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-16 h-4 border-2 border-gray-200 border-b-0 rounded-t-lg"></div>
            </div>
            <!-- Box Body -->
            <div id="box-body" class="absolute inset-0 bg-gray-50 rounded-b-xl z-10 flex flex-col items-center justify-center border-x-2 border-b-2 border-gray-200 shadow-2xl mt-[4px]">
                <div class="mt-8 space-y-1 flex flex-col items-center">
                    <p class="text-[10px] font-black text-red-600 uppercase tracking-[0.2em] animate-pulse">Deploy Personnel</p>
                    <div class="h-0.5 w-12 bg-red-200 rounded-full"></div>
                </div>
            </div>
            
            <!-- Pulse Line Effect -->
            <div id="pulse-scanner" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full border-2 border-red-500 rounded-xl opacity-0 scale-100 pointer-events-none"></div>
        </div>
    </section>

    <!-- Content Reveal Area -->
    <div id="main-content" class="px-6 relative z-10 hidden">
        <div class="max-w-7xl mx-auto flex flex-col items-center gap-32">
            {hierarchy.map((level, lIdx) => (
                <div class="flex flex-col items-center w-full hierarchy-section" data-level={lIdx}>
                    <div class="flex items-center gap-6 w-full mb-16">
                        <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent via-gray-200 to-transparent"></div>
                        <h2 class="text-[10px] font-black text-gray-400 uppercase tracking-[0.6em] px-6 py-2 bg-gray-50/80 backdrop-blur-sm rounded-full border border-gray-100 shadow-sm">
                            {level.level}
                        </h2>
                        <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent via-gray-200 to-transparent"></div>
                    </div>
                    
                    <div class="flex flex-wrap justify-center items-stretch gap-y-16 w-full">
                        {level.groups.map((group, gIdx) => (
                            <div class="contents">
                                <div class="flex flex-wrap justify-center gap-8 md:gap-16 px-12">
                                    {group.map((m, mIdx) => (
                                        <div class="member-card opacity-0 translate-y-8" data-stagger={mIdx}>
                                            <div class="relative group">
                                                <!-- Card Aesthetic -->
                                                <div class="absolute -inset-6 bg-gradient-to-b from-gray-50 to-transparent rounded-[2.5rem] opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-100"></div>
                                                
                                                <div class="relative flex flex-col items-center text-center">
                                                    <!-- Profile Image Wrapper -->
                                                    <div class={`relative rounded-2xl overflow-hidden mb-6 p-1.5 bg-white shadow-[0_10px_30px_-10px_rgba(0,0,0,0.1)] transition-all duration-700 cubic-bezier group-hover:-translate-y-3 group-hover:shadow-red-500/20 ${m.variant === 'primary' ? 'w-44 h-44' : 'w-36 h-36'}`}>
                                                        <div class="absolute inset-0 bg-red-600/0 group-hover:bg-red-600/5 transition-colors z-10"></div>
                                                        <img 
                                                            src={getImage(m.name)} 
                                                            alt={m.name} 
                                                            class="w-full h-full object-cover rounded-xl bg-gray-50 grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700"
                                                            loading="lazy" 
                                                        />
                                                        <!-- Medical Badge Tag -->
                                                        <div class="absolute bottom-3 right-3 bg-red-600 text-white p-1.5 rounded-lg shadow-xl z-20 transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                                                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                                <path d="M12 5V19M5 12H19" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                        </div>
                                                    </div>

                                                    <!-- Member Info -->
                                                    <div class="space-y-3">
                                                        <span class="inline-block text-[9px] font-black text-red-600 uppercase tracking-[0.25em] bg-red-50/50 px-4 py-1.5 rounded-full border border-red-100/50 backdrop-blur-sm">
                                                            {m.label}
                                                        </span>
                                                        <h3 class="text-sm md:text-base font-bold text-gray-900 leading-tight max-w-[180px] tracking-tight">
                                                            {m.name}
                                                        </h3>
                                                        <div class="flex items-center justify-center gap-1.5 opacity-30 group-hover:opacity-100 transition-opacity duration-500">
                                                            <div class="w-1 h-1 rounded-full bg-red-500"></div>
                                                            <div class="w-10 h-[1px] bg-red-200"></div>
                                                            <div class="w-1 h-1 rounded-full bg-red-500"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                                {gIdx < level.groups.length - 1 && (
                                    <div class="hidden lg:block w-[1px] self-stretch bg-gradient-to-b from-transparent via-gray-100 to-transparent mx-4"></div>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>

    <style>
        .box-open { 
            transform: rotateX(-120deg) translateY(-20px); 
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }

        .cubic-bezier {
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Pulse for the box */
        @keyframes pulse-ring {
            0% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.5; }
            50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0; }
            100% { transform: translate(-50%, -50%) scale(0.95); opacity: 0; }
        }

        .animate-pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>

    <script>
        const boxContainer = document.getElementById('medical-box-container');
        const boxLid = document.getElementById('box-lid');
        const mainContent = document.getElementById('main-content');
        const pulseScanner = document.getElementById('pulse-scanner');
        const sections = document.querySelectorAll('.hierarchy-section');

        let isOpened = false;

        boxContainer?.addEventListener('click', () => {
            if (isOpened) return;
            isOpened = true;

            boxLid?.classList.add('box-open');
            pulseScanner?.classList.add('animate-pulse-ring');
            
            setTimeout(() => {
                mainContent?.classList.remove('hidden');

                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -100px 0px'
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const levelCards = entry.target.querySelectorAll('.member-card');
                            levelCards.forEach((card, index) => {
                                setTimeout(() => {
                                    (card as HTMLElement).style.transition = 'all 1.2s cubic-bezier(0.2, 0.8, 0.2, 1)';
                                    (card as HTMLElement).style.opacity = '1';
                                    (card as HTMLElement).style.transform = 'translateY(0) scale(1)';
                                }, index * 180);
                            });
                            observer.unobserve(entry.target);
                        }
                    });
                }, observerOptions);

                sections.forEach(section => observer.observe(section));

                const rhythmicScroll = async () => {
                    const sectionElements = Array.from(sections) as HTMLElement[];
                    
                    for (let i = 0; i < sectionElements.length; i++) {
                        await new Promise(resolve => {
                            const target = sectionElements[i].getBoundingClientRect().top + window.scrollY - 150;
                            const start = window.scrollY;
                            const distance = target - start;
                            const duration = 900; 
                            let startTime: number | null = null;

                            function animation(currentTime: number) {
                                if (startTime === null) startTime = currentTime;
                                const timeElapsed = currentTime - startTime;
                                const run = ease(timeElapsed, start, distance, duration);
                                window.scrollTo(0, run);

                                if (timeElapsed < duration) {
                                    requestAnimationFrame(animation);
                                } else {
                                    setTimeout(resolve, 300);
                                }
                            }

                            function ease(t: number, b: number, c: number, d: number) {
                                t /= d / 2;
                                if (t < 1) return c / 2 * t * t * t + b;
                                t -= 2;
                                return c / 2 * (t * t * t + 2) + b;
                            }

                            requestAnimationFrame(animation);
                        });
                    }
                };

                setTimeout(rhythmicScroll, 800);

            }, 800);
        });
    </script>
  </main>
</Layout>