---
import Layout from "../../layouts/Layout.astro";

const getImage = (name: string) => {
    const map: Record<string, string> = {
        "Ms. Danti": "ms_danti.png",
        "Anugrah Alfan Dzikrillah": "alfan.png",
        "Shefina Putri Aurellia": "shefina.png",
        "Maulana Raihan An Naafi": "maul.png",
        "Alzena Ayu Prameswari": "alzeena.png",
        "Nawwaf Fathin Abdillah Hiranda": "nawwaf.png",
        "Nazran Ar Rais": "nazran.png",
        "Humairoh Azzahidah": "azzah.png",
        "Putri Aqila Zaneta": "zaneta.png",
        "Reyhan Adibrata Anggayana": "reyhan.png",
        "Nafisah Innasuha": "icha.png",
        "Alyaa Fauziah Khusnayain": "alyaa.png",
        "Muhammad Jaysan Fachry": "jaysan.png",
        "Tsabit Sabila Rusyda": "ela.png",
        "Maheswara Natha Mandala": "mahes.png",
        "Hasna Putri Adia Zameena": "hazna.png",
        "Zamraditya Kenzy Putra Samindra": "kenzy.png",
        "Nazhan Ar Rais": "nazhan.png",
        "Kayasmin Rania Azzahra": "kayasmin.png"
    };
    return `/mecaknights/${map[name] || 'default.png'}`;
};

const hierarchy = [
  { level: "Pembina", members: [{label: "Pembina", name: "Ms. Danti", variant: "primary"}] },
  { level: "Pimpinan", members: [
    {label: "Leader Putra", name: "Anugrah Alfan Dzikrillah", variant: "secondary"},
    {label: "Leader Putri", name: "Shefina Putri Aurellia", variant: "secondary"}
  ]},
  { level: "Wakil", members: [
    {label: "Vice Leader Putra", name: "Maulana Raihan An Naafi", variant: "secondary"},
    {label: "Vice Leader Putri", name: "Alzena Ayu Prameswari", variant: "secondary"}
  ]},
  { level: "Administrasi", members: [
    {label: "Sekretaris 1 Putra", name: "Nawwaf Fathin Abdillah Hiranda", variant: "tertiary"},
    {label: "Sekretaris 2 Putra", name: "Nazran Ar Rais", variant: "tertiary"},
    {label: "Bendahara Putra", name: "Reyhan Adibrata Anggayana", variant: "tertiary"},
    {label: "Sekretaris 1 Putri", name: "Humairoh Azzahidah", variant: "tertiary"},
    {label: "Sekretaris 2 Putri", name: "Putri Aqila Zaneta", variant: "tertiary"},
    {label: "Bendahara Putri", name: "Nafisah Innasuha", variant: "tertiary"}
  ]},
  { level: "Kepala Bidang", members: [
    {label: "Kabid Creavo Putra", name: "Muhammad Jaysan Fachry", variant: "tertiary"},
    {label: "Kabid MPR Putra", name: "Maheswara Natha Mandala", variant: "tertiary"},
    {label: "Kabid Faith Putra", name: "Zamraditya Kenzy Putra Samindra", variant: "tertiary"},
    {label: "Kabid Edurain Putra", name: "Nazhan Ar Rais", variant: "tertiary"},
    {label: "Kabid Creavo Putri", name: "Alyaa Fauziah Khusnayain", variant: "tertiary"},
    {label: "Kabid MPR Putri", name: "Tsabit Sabila Rusyda", variant: "tertiary"},
    {label: "Kabid Faith Putri", name: "Hasna Putri Adia Zameena", variant: "tertiary"},
    {label: "Kabid Edurain Putri", name: "Kayasmin Rania Azzahra", variant: "tertiary"}
  ]}
];
---

<Layout title="Meca Knights - PMR SMP ABBS Surakarta">
    <div class="meca-knights-wrapper relative min-h-screen overflow-x-hidden bg-[#050505] text-white selection:bg-red-600/30">
        <!-- Galaxy Background Elements -->
        <div class="fixed inset-0 pointer-events-none">
            <div class="stars-container absolute inset-0"></div>
            <div class="nebula-1 absolute top-[-10%] left-[-10%] w-[60%] h-[60%] rounded-full bg-purple-900/10 blur-[120px] animate-pulse-glow"></div>
            <div class="nebula-2 absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-blue-900/10 blur-[100px] animate-pulse-glow" style="animation-delay: 2s;"></div>
            <div class="nebula-3 absolute top-[30%] right-[10%] w-[30%] h-[30%] rounded-full bg-red-900/5 blur-[80px] animate-pulse-glow" style="animation-delay: 4s;"></div>
        </div>

        <!-- Flower Ornaments -->
        <div class="fixed inset-0 pointer-events-none overflow-hidden opacity-20">
            <div class="flower-1 absolute top-10 left-10 w-32 h-32 animate-float-slow">
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-purple-300/40">
                    <path d="M50 0C55 25 75 25 100 25C75 30 75 50 75 50C75 75 55 75 50 100C45 75 25 75 0 75C25 70 25 50 25 50C25 25 45 25 50 0Z" fill="currentColor"/>
                </svg>
            </div>
            <div class="flower-2 absolute bottom-20 right-10 w-48 h-48 animate-float" style="animation-delay: 1s;">
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-blue-300/30">
                    <path d="M50 0C55 25 75 25 100 25C75 30 75 50 75 50C75 75 55 75 50 100C45 75 25 75 0 75C25 70 25 50 25 50C25 25 45 25 50 0Z" fill="currentColor"/>
                </svg>
            </div>
        </div>

        <!-- Content -->
        <div class="relative z-10 container mx-auto px-6 py-20">
            <!-- Hero Section -->
            <header class="text-center mb-32 reveal">
                <div class="inline-block mb-6 relative">
                    <div class="absolute inset-0 bg-red-600 blur-2xl opacity-20 animate-pulse"></div>
                    <img src="/communities/meca_knight.png" alt="Meca Knights Logo" class="w-32 h-32 md:w-40 md:h-40 mx-auto relative z-10 drop-shadow-[0_0_15px_rgba(237,28,36,0.5)]" />
                </div>
                <h1 class="text-5xl md:text-7xl font-bold mb-4 tracking-tighter">
                    <span class="text-white">MECA</span>
                    <span class="text-[#ed1c24] drop-shadow-[0_0_10px_rgba(237,28,36,0.8)]">KNIGHTS</span>
                </h1>
                <p class="text-lg md:text-xl text-purple-200/60 font-bold tracking-[0.4em] uppercase max-w-2xl mx-auto">
                    PMR MADYA • SMP ABBS SURAKARTA
                </p>
                <div class="mt-8 flex justify-center gap-4">
                    <div class="h-px w-20 bg-gradient-to-r from-transparent to-red-600 self-center"></div>
                    <div class="text-red-500"><i data-feather="heart"></i></div>
                    <div class="h-px w-20 bg-gradient-to-l from-transparent to-red-600 self-center"></div>
                </div>
            </header>

            <!-- 7 Principles Section -->
            <section class="mb-40">
                <h2 class="text-3xl md:text-4xl font-bold mb-16 text-center reveal">
                    <span class="border-b-2 border-red-600 pb-2">7 Prinsip Dasar</span>
                    <span class="block text-sm font-normal text-purple-300/60 mt-4 tracking-[0.3em] uppercase">Palang Merah</span>
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-container">
                    {[
                        { title: "Kemanusiaan", desc: "Memberikan pertolongan tanpa membedakan korban dan berupaya mencegah serta mengatasi penderitaan sesama manusia." },
                        { title: "Kesamaan", desc: "Tidak membeda-bedakan korban berdasarkan kebangsaan, suku, agama, atau pandangan politik; mendahulukan yang paling membutuhkan." },
                        { title: "Kenetralan", desc: "Tidak memihak atau melibatkan diri dalam pertentangan politik, kesukuan, agama, atau ideologi." },
                        { title: "Kemandirian", desc: "Bersifat mandiri dan menjaga otonomi agar dapat bertindak sesuai prinsip, meski membantu pemerintah dalam bidang kemanusiaan." },
                        { title: "Kesukarelaan", desc: "Pemberian bantuan atau pelayanan yang dilakukan secara sukarela tanpa didasari oleh keinginan mencari keuntungan apa pun." },
                        { title: "Kesatuan", desc: "Hanya ada satu Palang Merah atau Bulan Sabit Merah di satu negara, yang terbuka untuk semua orang dan melaksanakan tugas di seluruh wilayah." },
                        { title: "Kesemestaan", desc: "Gerakan yang bersifat semesta di mana setiap perhimpunan memiliki hak dan tanggung jawab yang sama dalam menolong sesama di seluruh dunia." }
                    ].map((p, i) => (
                        <div class="reveal glass-card-meca p-8 rounded-3xl relative group hover:scale-[1.02] transition-all duration-500">
                            <div class="absolute -top-4 -left-4 w-12 h-12 bg-red-600 rounded-full flex items-center justify-center text-xl font-bold shadow-[0_0_15px_rgba(237,28,36,0.5)] z-20">
                                {i + 1}
                            </div>
                            <h3 class="text-2xl font-bold mb-4 text-red-400 group-hover:text-red-300 transition-colors">{p.title}</h3>
                            <p class="text-gray-300 leading-relaxed font-light">{p.desc}</p>
                            <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                <i data-feather="star" class="w-4 h-4 text-yellow-400/50"></i>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Tri Bakti Section -->
            <section class="max-w-4xl mx-auto mb-40 relative">
                <div class="absolute inset-0 -z-10 blur-[100px] opacity-10">
                    <div class="absolute top-0 left-1/4 w-64 h-64 bg-red-600 rounded-full animate-float"></div>
                    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-purple-600 rounded-full animate-float-slow"></div>
                </div>

                <div class="glass-card-meca p-10 md:p-16 rounded-[40px] border-2 border-red-600/20 reveal">
                    <h2 class="text-3xl md:text-5xl font-bold mb-12 text-center">
                        <span class="text-gradient-red">Tri Bakti PMR</span>
                    </h2>
                    
                    <div class="space-y-12">
                        {[
                            { icon: "heart", text: "Meningkatkan keterampilan hidup sehat." },
                            { icon: "users", text: "Berkarya dan berbakti di masyarakat." },
                            { icon: "globe", text: "Mempererat persahabatan nasional dan internasional." }
                        ].map((item, i) => (
                            <div class="flex items-start gap-6 reveal reveal-left" style={`transition-delay: ${i * 200}ms`}>
                                <div class="w-14 h-14 shrink-0 bg-red-600/20 rounded-2xl flex items-center justify-center text-red-500 border border-red-600/30 shadow-[0_0_15px_rgba(237,28,36,0.2)]">
                                    <i data-feather={item.icon}></i>
                                </div>
                                <p class="text-xl md:text-2xl font-light leading-snug pt-2">
                                    {item.text}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            </section>

            <!-- Hierarchy Interaction Section (The Celestial Unit) -->
            <section class="mb-40 flex flex-col items-center">
                <div class="text-center mb-16 reveal">
                    <h2 class="text-3xl md:text-5xl font-bold mb-4">
                        <span class="text-gradient-red">Hierarchy Structure</span>
                    </h2>
                    <p class="text-purple-300/60 uppercase tracking-[0.3em] text-sm">Tap the Celestial Kit to reveal the Knights</p>
                </div>

                <!-- Medical Box Interaction -->
                <div id="medical-box-container" class="relative w-48 h-32 cursor-pointer group animate-float transition-transform duration-500 hover:scale-110 z-50 mb-32">
                    <div id="box-lid" class="absolute inset-0 bg-white/95 rounded-lg border-b-4 border-gray-200 origin-top transition-transform duration-[1200ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] z-20 flex items-center justify-center border-x-2 border-t shadow-[0_0_30px_rgba(255,255,255,0.2)] overflow-hidden">
                        <!-- Red Cross Glow -->
                        <div class="absolute inset-0 bg-red-600/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="w-12 h-12 bg-red-600 rounded flex items-center justify-center shadow-inner relative z-10">
                            <div class="absolute w-7 h-2 bg-white rounded-full"></div>
                            <div class="absolute w-2 h-7 bg-white rounded-full"></div>
                        </div>
                    </div>
                    <div id="box-body" class="absolute inset-0 bg-gray-100/90 rounded-b-lg z-10 flex flex-col items-center justify-center border-t-2 border-gray-200 border-x-2 border-b-2 shadow-[0_20px_40px_rgba(0,0,0,0.5)] mt-[2px]">
                        <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mt-10">Celestial Kit</p>
                    </div>
                    <!-- Ambient Glow behind box -->
                    <div class="absolute inset-0 bg-red-600 blur-3xl opacity-20 group-hover:opacity-40 transition-opacity"></div>
                </div>

                <!-- Spilled Hierarchy Content -->
                <div id="main-content" class="w-full relative z-10 pointer-events-none opacity-0 transition-opacity duration-1000">
                    <div class="max-w-6xl mx-auto flex flex-col items-center gap-24">
                        {hierarchy.map((level) => (
                            <div class="flex flex-col items-center w-full hierarchy-section">
                                <h3 class="text-sm font-bold text-red-500/60 uppercase tracking-[0.5em] mb-12 border-b border-red-500/20 pb-4 w-full text-center max-w-sm section-title opacity-0 transition-opacity duration-[1500ms]">
                                    {level.level}
                                </h3>
                                <div class="flex flex-wrap justify-center gap-8 md:gap-16 w-full">
                                    {level.members.map((m) => (
                                        <div class="member-card opacity-0">
                                            <div class="flex flex-col items-center text-center group">
                                                <div class={`relative rounded-[2rem] overflow-hidden border-2 border-white/10 glass-card-meca mb-6 transition-all duration-500 group-hover:scale-110 group-hover:border-red-500/50 group-hover:shadow-[0_0_30px_rgba(237,28,36,0.3)] ${m.variant === 'primary' ? 'w-32 h-32 md:w-40 md:h-40' : 'w-24 h-24 md:w-32 md:h-32'}`}>
                                                    <img src={getImage(m.name)} alt={m.name} class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-700" loading="lazy" />
                                                    <!-- Overlay Sparkle -->
                                                    <div class="absolute inset-0 bg-gradient-to-t from-red-600/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                                </div>
                                                <p class="text-[9px] md:text-[10px] font-black text-red-500 uppercase tracking-[0.2em] bg-red-500/10 border border-red-500/30 px-4 py-1.5 rounded-full mb-3 shadow-[0_0_10px_rgba(237,28,36,0.1)] group-hover:bg-red-500 group-hover:text-white transition-all">
                                                    {m.label}
                                                </p>
                                                <p class="text-sm md:text-base font-bold text-white max-w-[150px] leading-tight group-hover:text-red-300 transition-colors">
                                                    {m.name}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        </div>

        <!-- Floating Particles -->
        <div id="particles-container" class="fixed inset-0 pointer-events-none z-20"></div>
    </div>
</Layout>

<style is:global>
    @import "@fontsource/outfit/700.css";
    @import "@fontsource/inter/300.css";
    @import "@fontsource/inter/400.css";
    @import "@fontsource/inter/700.css";
    @import "@fontsource/inter/900.css";

    .glass-card-meca {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.8);
    }

    .text-gradient-red {
        background: linear-gradient(to right, #ffffff, #ed1c24, #ffffff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    main {
        padding: 0 !important;
    }

    .stars-container::before {
        content: "";
        position: absolute;
        width: 2px;
        height: 2px;
        background: transparent;
        box-shadow: 
            24vw 15vh 1px #fff, 12vw 32vh 1px #fff, 88vw 55vh 1px #fff, 
            45vw 88vh 1px #fff, 67vw 22vh 1px #fff, 33vw 44vh 1px #fff,
            10vw 70vh 1.5px #fff, 90vw 10vh 1px #fff, 50vw 50vh 1.5px #fff,
            75vw 80vh 1px #fff, 20vw 90vh 1px #fff, 80vw 30vh 1.5px #fff,
            15vw 15vh 1px #fff, 85vw 85vh 1px #fff, 40vw 10vh 1.5px #fff;
        animation: stars-twinkle 4s infinite alternate;
    }

    @keyframes stars-twinkle {
        from { opacity: 0.3; }
        to { opacity: 0.8; }
    }

    .petal {
        position: absolute;
        background: radial-gradient(circle, rgba(237, 28, 36, 0.2) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .box-open { 
        transform: rotateX(-160deg) translateY(-10px); 
    }

    .cards-visible .member-card {
        opacity: 1;
    }

    .cards-visible .section-title {
        opacity: 1;
    }
</style>

<script>
    function initMecaEffects() {
        // Effects initialization
        const container = document.querySelector('.stars-container');
        if (container && container.children.length === 0) {
            for (let i = 0; i < 100; i++) {
                const star = document.createElement('div');
                star.className = 'absolute bg-white rounded-full pointer-events-none';
                const size = Math.random() * 2;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.top = `${Math.random() * 100}%`;
                star.style.left = `${Math.random() * 100}%`;
                star.style.opacity = Math.random().toString();
                star.style.animation = `stars-twinkle ${2 + Math.random() * 3}s infinite alternate ${Math.random() * 2}s`;
                container.appendChild(star);
            }
        }

        const particleContainer = document.getElementById('particles-container');
        if (particleContainer && particleContainer.children.length === 0) {
            for (let i = 0; i < 20; i++) {
                const particle = document.createElement('div');
                particle.className = 'petal absolute animate-float-slow';
                const size = 5 + Math.random() * 15;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.top = `${Math.random() * 100}%`;
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.opacity = (0.1 + Math.random() * 0.3).toString();
                particle.style.animationDuration = `${10 + Math.random() * 20}s`;
                particleContainer.appendChild(particle);
            }
        }

        // Hierarchy Interaction Logic
        const boxContainer = document.getElementById('medical-box-container');
        const boxLid = document.getElementById('box-lid');
        const mainContent = document.getElementById('main-content');
        const cards = document.querySelectorAll('.member-card');
        const sections = document.querySelectorAll('.section-title');

        let isOpened = false;

        boxContainer?.addEventListener('click', () => {
            if (isOpened) return;
            isOpened = true;

            boxLid?.classList.add('box-open');
            boxContainer.classList.remove('animate-float');
            boxContainer.style.cursor = 'default';
            
            const boxRect = boxContainer.getBoundingClientRect();
            const boxCenterX = boxRect.left + boxRect.width / 2;
            const boxCenterY = boxRect.top + boxRect.height / 2;

            if (mainContent) {
                mainContent.classList.remove('opacity-0', 'pointer-events-none');
                mainContent.classList.add('opacity-100');
            }

            setTimeout(() => {
                cards.forEach((card, i) => {
                    const cardRect = card.getBoundingClientRect();
                    const cardCenterX = cardRect.left + cardRect.width / 2;
                    const cardCenterY = cardRect.top + cardRect.height / 2;

                    const startX = boxCenterX - cardCenterX;
                    const startY = boxCenterY - cardCenterY;

                    const scatterAngle = Math.random() * Math.PI * 2;
                    const scatterDistance = Math.random() * 250 + 100;
                    const scatterX = startX + Math.cos(scatterAngle) * scatterDistance;
                    const scatterY = startY + Math.sin(scatterAngle) * scatterDistance - 100;
                    const randomRotation = (Math.random() - 0.5) * 360;

                    (card as HTMLElement).animate([
                        { 
                            transform: `translate(${startX}px, ${startY}px) scale(0) rotate(0deg)`,
                            opacity: 0,
                            offset: 0 
                        },
                        { 
                            transform: `translate(${scatterX}px, ${scatterY}px) scale(1.1) rotate(${randomRotation}deg)`,
                            opacity: 1,
                            offset: 0.5 
                        },
                        { 
                            transform: `translate(0, 0) scale(1) rotate(0deg)`,
                            opacity: 1,
                            offset: 1 
                        }
                    ], {
                        duration: 2200,
                        delay: i * 55,
                        easing: 'cubic-bezier(0.25, 1, 0.5, 1)', 
                        fill: 'forwards'
                    });

                    setTimeout(() => {
                        (card as HTMLElement).style.opacity = '1';
                        (card as HTMLElement).style.transform = 'none';
                    }, 2200 + (i * 55));
                });

                mainContent?.classList.add('cards-visible');
                sections.forEach((section, i) => {
                    (section as HTMLElement).style.transitionDelay = `${1200 + (i * 150)}ms`;
                });

            }, 500);
        });
    }

    // Initialize on load and on astro navigation
    document.addEventListener('DOMContentLoaded', initMecaEffects);
    document.addEventListener('astro:page-load', initMecaEffects);
</script>
