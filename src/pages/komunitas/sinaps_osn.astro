---
import Layout from "../../layouts/Layout.astro";
import SinapsCover from "../../components/osn/SinapsCover.astro";
import SinapsIntro from "../../components/osn/SinapsIntro.astro";
import SinapsIpa from "../../components/osn/SinapsIpa.astro";
import SinapsIps from "../../components/osn/SinapsIps.astro";
import SinapsMath from "../../components/osn/SinapsMath.astro";
import SinapsStructure from "../../components/osn/SinapsStructure.astro";
import SinapsCta from "../../components/osn/SinapsCta.astro";
---

<Layout title="SINAPS - Scientific & Intellectual Squad">
    <main class="min-h-screen bg-[#001414] flex items-center justify-center p-6 overflow-hidden">
        <!-- Subtle Organic Background -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <div class="absolute inset-0" style="background-image: url('https://www.transparenttextures.com/patterns/pinstriped-suit.png');"></div>
        </div>

        <div class="book-container relative shadow-[0_50px_100px_rgba(0,0,0,0.6)]">
            <div id="book" class="book relative transition-transform duration-1000 ease-in-out">
                
                <SinapsCover id="p1" />
                <SinapsIntro id="p2" />
                <SinapsIpa id="p3" />
                <SinapsIps id="p4" />
                <SinapsMath id="p5" />
                <SinapsStructure id="p6" />
                <SinapsCta id="p7" />
            </div>

            <!-- Organic Navigation Hints (Inside container to sync with book movement) -->
            <div id="nav-hints" class="absolute -bottom-16 left-1/2 -translate-x-1/2 flex items-center gap-12 text-white/20 text-[10px] font-serif italic tracking-widest uppercase transition-all duration-1000 ease-in-out">
                <span class="flex items-center gap-3 hover:text-white/40 transition-colors cursor-default"><kbd class="bg-white/5 px-2 py-1 rounded border border-white/10 text-white/30">←</kbd> Back</span>
                <span class="flex items-center gap-3 animate-pulse hover:text-white/40 transition-colors cursor-default"><kbd class="bg-white/5 px-2 py-1 rounded border border-white/10 text-white/30">→</kbd> Next</span>
                <span class="flex items-center gap-3 hover:text-white/40 transition-colors cursor-default"><kbd class="bg-white/5 px-2 py-1 rounded border border-white/10 text-white/30">Esc</kbd> Reset</span>
            </div>
        </div>
    </main>

    <style is:global>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,900;1,400&family=Inter:wght@300;400;700&family=Architects+Daughter&display=swap');

        .font-hand {
            font-family: 'Architects Daughter', cursive;
        }

        .book-container {
            width: min(550px, 90vw);
            height: min(750px, 85vh);
            perspective: 2500px;
            transition: all 0.5s ease;
        }

        @media (min-width: 1200px) {
            .book-container {
                width: 600px;
                height: 800px;
            }
        }

        .book {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
        }

        .page {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            transform-origin: left;
            transform-style: preserve-3d;
            transition: transform 1.2s cubic-bezier(0.645, 0.045, 0.355, 1);
            z-index: 1;
            pointer-events: none;
        }

        .page.active {
            z-index: 10;
            pointer-events: auto;
        }

        .page.flipped .back {
            pointer-events: auto;
        }

        .front, .back {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            backface-visibility: hidden;
            border-radius: 0 15px 15px 0;
            overflow-y: auto;
        }

        .front::-webkit-scrollbar, .back::-webkit-scrollbar {
            display: none;
        }
        .front, .back {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .page:not(#p1) .front, 
        .page:not(#p7) .back,
        #p1 .back,
        #p7 .front {
            background-color: #fdfdfb;
            background-image: 
                linear-gradient(#e5e7eb 1px, transparent 1px),
                linear-gradient(90deg, #e5e7eb 1px, transparent 1px);
            background-size: 30px 30px;
        }

        #p1 .front {
            background-color: #002b2b !important;
            background-image: none !important;
            border-radius: 4px 15px 15px 4px;
            overflow: hidden;
        }

        #p7 .back {
            background-color: #002b2b !important;
            background-image: none !important;
            border-radius: 15px 4px 4px 15px;
            overflow: hidden;
        }

        .back {
            transform: rotateY(180deg);
            border-radius: 15px 0 0 15px;
        }

        .flipped {
            transform: rotateY(-180deg);
        }

        #p1 { z-index: 7; }
        #p2 { z-index: 6; }
        #p3 { z-index: 5; }
        #p4 { z-index: 4; }
        #p5 { z-index: 3; }
        #p6 { z-index: 2; }
        #p7 { z-index: 1; }

        .font-serif {
            font-family: 'Playfair Display', serif;
        }
    </style>

    <script>
        let currentLoc = 1;
        let numOfPapers = 7;
        let maxLoc = numOfPapers + 1;

        function flipPage(target: number) {
            const book = document.getElementById('book');
            if (!book) return;
            
            if (target > 0) {
                if (currentLoc < maxLoc) {
                    const page = document.getElementById(`p${currentLoc}`);
                    if (page) {
                        page.classList.add('flipped');
                        page.classList.remove('active');
                        setTimeout(() => {
                            if (page.classList.contains('flipped')) {
                                page.style.zIndex = currentLoc.toString();
                            }
                        }, 600);
                    }
                    
                    const nextPaper = document.getElementById(`p${currentLoc + 1}`);
                    if (nextPaper) {
                        nextPaper.classList.add('active');
                        (nextPaper as HTMLElement).style.zIndex = "10";
                    }
                    
                    currentLoc++;
                    book.style.transform = `translateX(50%)`;
                }
            } else {
                if (target === -7) {
                    const allPages = document.querySelectorAll('.page');
                    allPages.forEach((page, index) => {
                        page.classList.remove('flipped');
                        page.classList.remove('active');
                        (page as HTMLElement).style.zIndex = (numOfPapers - index).toString();
                    });
                    
                    const p1 = document.getElementById('p1');
                    if (p1) {
                        p1.classList.add('active');
                        p1.style.zIndex = "10";
                    }
                    
                    currentLoc = 1;
                    book.style.transform = `translateX(0)`;
                    return;
                }

                if (currentLoc > 1) {
                    currentLoc--;
                    const page = document.getElementById(`p${currentLoc}`);
                    if (page) {
                        page.classList.remove('flipped');
                        page.classList.add('active');
                        page.style.zIndex = "10";
                    }
                    
                    const nextPaper = document.getElementById(`p${currentLoc + 1}`);
                    if (nextPaper) {
                        nextPaper.classList.remove('active');
                        (nextPaper as HTMLElement).style.zIndex = (numOfPapers - (currentLoc + 1) + 1).toString();
                    }
                    
                    if (currentLoc === 1) {
                        book.style.transform = `translateX(0)`;
                    }
                }
            }
        }

        (window as any).flipPage = flipPage;

        // Touch Gestures for Mobile
        let touchstartX = 0;
        let touchendX = 0;
        const swipeThreshold = 50;

        const bookContainer = document.querySelector('.book-container');
        if (bookContainer) {
            bookContainer.addEventListener('touchstart', (e: any) => {
                touchstartX = e.changedTouches[0].screenX;
            }, { passive: true });

            bookContainer.addEventListener('touchend', (e: any) => {
                touchendX = e.changedTouches[0].screenX;
                handleSwipe();
            }, { passive: true });
        }

        function handleSwipe() {
            const diff = touchstartX - touchendX;
            if (Math.abs(diff) > swipeThreshold) {
                if (diff > 0) {
                    // Swipe Left -> Next
                    flipPage(1);
                } else {
                    // Swipe Right -> Back
                    flipPage(-1);
                }
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space' || e.code === 'ArrowRight') {
                flipPage(1);
            } else if (e.code === 'ArrowLeft') {
                flipPage(-1);
            } else if (e.code === 'Escape') {
                flipPage(-7);
            }
        });
    </script>

    <script src="https://unpkg.com/feather-icons"></script>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        });
        window.addEventListener('load', () => {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        });
    </script>
</Layout>
