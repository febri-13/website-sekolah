---
// src/pages/kontak.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kontak - ABBS Surakarta">
    <!-- Hero Section -->
    <section
        class="bg-gradient-to-br from-primary-600 via-primary-500 to-primary-700 text-white py-20"
    >
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Hubungi Kami</h1>
            <p class="text-primary-100 text-lg">Kami siap membantu Anda</p>
        </div>
    </section>

    <!-- Contact Info Cards -->
    <section class="py-16 bg-cream-50 dark:bg-gray-900">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid md:grid-cols-3 gap-8 -mt-24">
                <!-- Alamat -->
                <div
                    class="bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-lg border-t-4 border-primary-500 hover:shadow-2xl transition-all transform hover:-translate-y-1"
                >
                    <div
                        class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center text-2xl mb-6"
                    >
                        <i data-feather="map-pin" class="w-7 h-7 text-white"></i>
                    </div>
                    <h3
                        class="text-lg font-bold text-gray-900 dark:text-white mb-3"
                    >
                        Alamat
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
                        <a
                            href="https://maps.app.goo.gl/nhtZbKCV35aSe5dXA"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                        >
                            Jl. Tarumanegara III, Banyuanyar, Kec. Banjarsari,
                            Kota Surakarta, Jawa Tengah 57137
                        </a>
                    </p>
                </div>

                <!-- Telepon -->
                <div
                    class="bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-lg border-t-4 border-tertiary-500 hover:shadow-2xl transition-all transform hover:-translate-y-1"
                >
                    <div
                        class="w-14 h-14 bg-gradient-to-br from-tertiary-500 to-tertiary-600 rounded-2xl flex items-center justify-center text-2xl mb-6"
                    >
                        <i data-feather="phone" class="w-7 h-7 text-white"></i>
                    </div>
                    <h3
                        class="text-lg font-bold text-gray-900 dark:text-white mb-3"
                    >
                        Telepon
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
                        <a
                            href="https://wa.me/6282242719492"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                        >
                            Whatsapp: +62 822-4271-9492 (Ms Nourma)
                        </a>
                    </p>
                </div>

                <!-- Email dan Pendaftaran -->
                <div
                    class="bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-lg border-t-4 border-secondary-400 hover:shadow-2xl transition-all transform hover:-translate-y-1"
                >
                    <div
                        class="w-14 h-14 bg-gradient-to-br from-secondary-400 to-secondary-500 rounded-2xl flex items-center justify-center text-2xl mb-6"
                    >
                        <i data-feather="mail" class="w-7 h-7 text-white"></i>
                    </div>
                    <h3
                        class="text-lg font-bold text-gray-900 dark:text-white mb-3"
                    >
                        Email
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">
                        <a
                            href="mailto:smpabbs@alabidin.sch.id"
                            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                        >
                            Gmail: <b>smpabbs@alabidin.sch.id</b>
                        </a>
                        <br />
                        <a
                            href="https://tally.so/r/WOrRgQ?fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQMMjU2MjgxMDQwNTU4AAGnY_g3jRKRppEhqoFFX3R9acWYO8jui9rSXHjVpWE-pThk6vwBS3HLH7Z_MQ8_aem_i-6gl4OOMbD8qgEUAdHViA"
                            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                        >
                            Pendaftaran: <b
                                >Klik disini untuk daftar sekarang!</b
                            >
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Social Media Section -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2
                class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-8"
            >
                Ikuti Kami di Social Media
            </h2>
            <div class="flex justify-center gap-4 flex-wrap">
                <a
                    href="https://www.facebook.com/people/Smpabbs-Surakarta/100094726835282/#"
                    class="w-14 h-14 bg-primary-600 hover:bg-primary-700 text-white rounded-full flex items-center justify-center text-2xl transition-all transform hover:scale-110 shadow-lg"
                    aria-label="Facebook"
                >
                    <i data-feather="facebook" class="w-6 h-6"></i>
                </a>
                <a
                    href="https://www.instagram.com/smpabbssurakarta"
                    class="w-14 h-14 bg-purple-500 hover:bg-purple-600 text-white rounded-full flex items-center justify-center text-2xl transition-all transform hover:scale-110 shadow-lg"
                    aria-label="Instagram"
                >
                    <i data-feather="camera" class="w-6 h-6"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Map Section (Optional) -->
    <section class="py-0">
        <div class="w-full h-96 bg-gray-300 dark:bg-gray-700">
            <!-- 
        GANTI dengan Google Maps Embed Link kamu
        Cara: Buka Google Maps -> Cari lokasi -> Share -> Embed a map -> Copy iframe
      -->
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d31642.821748116025!2d110.8052151!3d-7.5364554!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a1545963f8f0b%3A0xd7f3fa0e94db1dd1!2sSMP%20ABBS%20SURAKARTA!5e0!3m2!1sid!2sid!4v1778116822748!5m2!1sid!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="grayscale hover:grayscale-0 transition-all duration-300"
            ></iframe>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="py-16 bg-gradient-to-br from-primary-600 via-primary-500 to-tertiary-500 text-white"
    >
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Kunjungi Kami</h2>
            <p class="text-xl mb-8 text-primary-100">
                Jadwalkan kunjungan untuk melihat langsung fasilitas dan bertemu
                dengan tim kami
            </p>
            <a
                href="#"
                class="inline-block bg-secondary-400 text-dark-700 px-8 py-4 rounded-lg font-bold hover:bg-secondary-300 transition-all shadow-xl text-lg"
            >
                <i data-feather="calendar" class="inline-block w-5 h-5 mr-2"
                ></i>Jadwalkan Kunjungan
            </a>
        </div>
    </section>
</Layout>
