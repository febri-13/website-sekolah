---
// src/pages/kontak.astro
// import Layout from "../layouts/Layout.astro";

// src/pages/kontak.astro
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/cta/CTASection.astro";
---

<Layout title="Kontak - SMP ABBS Surakarta">
    <!-- Hero Header -->
    <section
        class="pt-40 pb-24 relative overflow-hidden text-center bg-cream-50 dark:bg-gray-950"
    >
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 opacity-50"
        >
            <div
                class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-primary-500/10 blur-[120px] rounded-full animate-pulse"
            >
            </div>
            <div
                class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-secondary-500/5 blur-[100px] rounded-full animate-pulse"
                style="animation-delay: 2s;"
            >
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-6 reveal">
            <span
                class="inline-block px-4 py-1 mb-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 text-sm font-bold tracking-widest uppercase"
            >
                Let's Connect
            </span>
            <h1
                class="text-6xl md:text-[9rem] font-[900] text-gray-900 dark:text-white mb-8 tracking-tighter leading-[0.8]"
            >
                Get in <span
                    class="text-transparent bg-clip-text bg-gradient-to-br from-primary-600 to-primary-400"
                    >Touch.</span
                >
            </h1>
            <p
                class="text-xl md:text-2xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto font-light leading-relaxed"
            >
                Punya pertanyaan tentang pendaftaran atau program kami? Kami di
                sini untuk membantu Anda menemukan solusi terbaik.
            </p>
        </div>
    </section>

    <!-- Contact Info Cards -->
    <section class="py-24 relative">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-3 gap-10 reveal">
                <!-- Alamat -->
                <div class="group relative">
                    <div
                        class="absolute inset-0 bg-primary-500/5 blur-2xl rounded-[2.5rem] opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                    <div
                        class="relative h-full bg-white dark:bg-gray-900/40 backdrop-blur-sm rounded-[2.5rem] p-10 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-2xl transition-all duration-500 group-hover:-translate-y-2"
                    >
                        <div
                            class="w-14 h-14 bg-primary-50 dark:bg-primary-900/20 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 mb-8 group-hover:scale-110 transition-transform duration-500"
                        >
                            <i data-feather="map-pin" class="w-7 h-7"></i>
                        </div>
                        <h3
                            class="text-2xl font-bold text-gray-900 dark:text-white mb-4"
                        >
                            Alamat
                        </h3>
                        <p
                            class="text-gray-500 dark:text-gray-400 leading-relaxed font-light mb-6"
                        >
                            Jl. Tarumanegara III, Banyuanyar, Kec. Banjarsari,
                            Kota Surakarta, Jawa Tengah 57137
                        </p>
                        <a
                            href="https://maps.app.goo.gl/nhtZbKCV35aSe5dXA"
                            target="_blank"
                            class="text-sm font-bold text-primary-600 dark:text-primary-400 flex items-center gap-2 group/link"
                        >
                            Petunjuk Arah <i
                                data-feather="arrow-right"
                                class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"
                            ></i>
                        </a>
                    </div>
                </div>

                <!-- Telepon -->
                <div class="group relative">
                    <div
                        class="absolute inset-0 bg-secondary-500/5 blur-2xl rounded-[2.5rem] opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                    <div
                        class="relative h-full bg-white dark:bg-gray-900/40 backdrop-blur-sm rounded-[2.5rem] p-10 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-2xl transition-all duration-500 group-hover:-translate-y-2"
                    >
                        <div
                            class="w-14 h-14 bg-secondary-50 dark:bg-secondary-900/20 rounded-2xl flex items-center justify-center text-secondary-600 dark:text-secondary-400 mb-8 group-hover:scale-110 transition-transform duration-500"
                        >
                            <i data-feather="phone" class="w-7 h-7"></i>
                        </div>
                        <h3
                            class="text-2xl font-bold text-gray-900 dark:text-white mb-4"
                        >
                            Telepon
                        </h3>
                        <p
                            class="text-gray-500 dark:text-gray-400 leading-relaxed font-light mb-6"
                        >
                            Layanan informasi dan pendaftaran melalui WhatsApp
                            Center Ms Nourma.
                        </p>
                        <a
                            href="https://wa.me/6282242719492"
                            target="_blank"
                            class="text-sm font-bold text-secondary-600 dark:text-secondary-400 flex items-center gap-2 group/link"
                        >
                            Chat WhatsApp <i
                                data-feather="message-circle"
                                class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"
                            ></i>
                        </a>
                    </div>
                </div>

                <!-- Email -->
                <div class="group relative">
                    <div
                        class="absolute inset-0 bg-primary-500/5 blur-2xl rounded-[2.5rem] opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                    <div
                        class="relative h-full bg-white dark:bg-gray-900/40 backdrop-blur-sm rounded-[2.5rem] p-10 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-2xl transition-all duration-500 group-hover:-translate-y-2"
                    >
                        <div
                            class="w-14 h-14 bg-primary-50 dark:bg-primary-900/20 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 mb-8 group-hover:scale-110 transition-transform duration-500"
                        >
                            <i data-feather="mail" class="w-7 h-7"></i>
                        </div>
                        <h3
                            class="text-2xl font-bold text-gray-900 dark:text-white mb-4"
                        >
                            Email
                        </h3>
                        <p
                            class="text-gray-500 dark:text-gray-400 leading-relaxed font-light mb-6"
                        >
                            Kirimkan pertanyaan atau dokumen resmi melalui
                            alamat email institusi kami.
                        </p>
                        <a
                            href="mailto:smpabbs@alabidin.sch.id"
                            class="text-sm font-bold text-primary-600 dark:text-primary-400 flex items-center gap-2 group/link"
                        >
                            Kirim Email <i
                                data-feather="send"
                                class="w-4 h-4 group-hover/link:translate-x-1 transition-transform"
                            ></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Social Media Section -->
    <section class="py-24 bg-gray-50/50 dark:bg-white/5 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 text-center reveal">
            <h2
                class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white mb-12 tracking-tight"
            >
                Ikuti <span class="text-primary-600 dark:text-primary-400"
                    >Update Kami</span
                >
            </h2>
            <div class="flex justify-center gap-8 flex-wrap">
                {
                    [
                        {
                            name: "Facebook",
                            icon: "facebook",
                            href: "https://www.facebook.com/people/Smpabbs-Surakarta/100094726835282/#",
                        },
                        {
                            name: "Instagram",
                            icon: "instagram",
                            href: "https://www.instagram.com/smpabbssurakarta",
                        },
                        {
                            name: "YouTube",
                            icon: "youtube",
                            href: "https://www.youtube.com/@SMPABBSSURAKARTA",
                        },
                    ].map((social) => (
                        <a
                            href={social.href}
                            class="group flex flex-col items-center gap-4"
                        >
                            <div class="w-20 h-20 rounded-3xl bg-white dark:bg-gray-900 flex items-center justify-center text-gray-400 border border-gray-100 dark:border-gray-800 shadow-sm group-hover:bg-primary-600 group-hover:text-white group-hover:shadow-xl group-hover:shadow-primary-500/20 group-hover:-translate-y-2 transition-all duration-500">
                                <i data-feather={social.icon} class="w-8 h-8" />
                            </div>
                            <span class="text-sm font-bold text-gray-500 dark:text-gray-400 tracking-widest uppercase">
                                {social.name}
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="py-0 reveal">
        <div class="w-full h-[500px] relative overflow-hidden">
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d31642.821748116025!2d110.8052151!3d-7.5364554!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a1545963f8f0b%3A0xd7f3fa0e94db1dd1!2sSMP%20ABBS%20SURAKARTA!5e0!3m2!1sid!2sid!4v1778116822748!5m2!1sid!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="grayscale hover:grayscale-0 transition-all duration-700"
            ></iframe>
        </div>
    </section>

    <!-- CTA Section -->
    <CTASection
        id="kontak-cta"
        title="Hubungi Kami"
        description="Kami siap membantu Anda. Jangan ragu untuk menghubungi kami melalui kanal yang tersedia."
        primaryButton={{
            text: "Chat Langsung",
            href: "https://wa.me/6282242719492",
            icon: "calendar",
        }}
        secondaryButton={{
            text: "Daftar Sekarang",
            href: "https://tally.so/r/WOrRgQ",
            icon: "edit-3",
        }}
    />
</Layout>
