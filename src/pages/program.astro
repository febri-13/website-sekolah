---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/cta/CTASection.astro';

const programs = [
    {
    id: 'ict',
    title: 'Program ICT',
    icon: 'code',
    description: 'Program pengembangan kompetensi teknologi informasi dan komunikasi untuk siswa.',
    features: [
      'Pengenalan pemrograman dasar',
      'Penggunaan software produktif',
      'Project-based learning dalam bidang TI',
      'ICT Show'
    ],
    borderColor: 'border-primary-500',
    gradientFrom: 'from-primary-500',
    gradientTo: 'to-primary-600'
  },
  {
    id: 'tahfidz',
    title: 'Program Tahfidz',
    icon: 'book',
    description: 'Program menghafal Al-Qur\'an dengan metode yang terbukti efektif, dibimbing oleh ustadz/ustadzah hafidz berpengalaman.',
    features: [
      'Target hafalan minimal 5 juz dalam 3 tahun',
      'Metode Tilawati & Yanbu\'a yang terbukti efektif',
      'Muroja\'ah rutin setiap hari',
      'Wisuda tahfidz setiap tahun ajaran'
    ],
    borderColor: 'border-tertiary-500',
    gradientFrom: 'from-tertiary-500',
    gradientTo: 'to-tertiary-600'
  },
  {
    id: 'leadership',
    title: 'Leadership Development',
    icon: 'briefcase',
    description: 'Program pengembangan kepemimpinan melalui organisasi siswa, kepanitiaan, dan berbagai kegiatan yang melatih soft skills.',
    features: [
      'OSIS, PMR, Dewan Galang yang aktif dan terstruktur',
      'Public Speaking Training rutin',
      'Event Management Workshop',
      'Student Leadership Conference tahunan'
    ],
    borderColor: 'border-primary-500',
    gradientFrom: 'from-primary-500',
    gradientTo: 'to-primary-600'
  },
  {
    id: 'steam',
    title: 'STEM Education',
    icon: 'code',
    description: 'Pembelajaran berbasis Science, Technology, Engineering, dan Mathematics untuk mengembangkan critical thinking dan problem solving.',
    features: [
      'Coding & Robotics Club',
      'Kompetisi sains tingkat regional & nasional',
      'Project-based learning yang aplikatif'
    ],
    borderColor: 'border-tertiary-500',
    gradientFrom: 'from-tertiary-500',
    gradientTo: 'to-tertiary-600'
  },
  {
    id: 'extracurricular',
    title: 'Ekstrakurikuler',
    icon: 'zap',
    description: 'Beragam pilihan ekstrakurikuler untuk mengembangkan bakat dan minat siswa di bidang olahraga, seni, dan akademik.',
    features: [
      'Olahraga: Futsal, Basket, Badminton, Silat',
      'Media: Jurnalistik, Fotografi, Sinematografi',
      'Seni: Qasidah, Hadroh, Rebana, Band',
      'Akademik: English Club, Science Club, Math Club, Robotik, Coding', 
    ],
    borderColor: 'border-secondary-400',
    gradientFrom: 'from-secondary-400',
    gradientTo: 'to-secondary-500'
  }
];
---

<Layout title="Program - ABBS Surakarta">

  <!-- Programs Grid Section -->
  <section class="py-20 bg-cream-50 dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          Program Unggulan Kami
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto text-lg">
          Berbagai program dirancang untuk mengembangkan potensi siswa secara maksimal
        </p>
        <div class="w-20 h-1 bg-primary-600 mx-auto mt-6"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {programs.map((program) => (
          <div class={`bg-white dark:bg-gray-800 rounded-3xl p-8 shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border-t-4 ${program.borderColor} group`}>
            <div class={`w-16 h-16 bg-gradient-to-br ${program.gradientFrom} ${program.gradientTo} rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-lg text-white group-hover:scale-110 transition-transform`}>
              <i data-feather={program.icon} class="w-8 h-8"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              {program.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
              {program.description}
            </p>
            <ul class="space-y-3">
              {program.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-tertiary-500 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-sm text-gray-600 dark:text-gray-400">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Learning Approach Section -->
  <section class="py-16 bg-white dark:bg-gray-800">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Metode Pembelajaran
        </h2>
        <p class="text-gray-600 dark:text-gray-400">
          Pendekatan pembelajaran yang inovatif dan terbukti efektif
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-1 border-t-4 border-primary-500">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center text-3xl mb-4 shadow-lg">
            <i data-feather="target" class="w-10 h-10"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Student-Centered</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Pembelajaran berpusat pada siswa dengan pendekatan personal
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-1 border-t-4 border-tertiary-500">
            <div class="w-16 h-16 bg-gradient-to-br from-tertiary-500 to-tertiary-600 rounded-2xl flex items-center justify-center text-3xl mb-4 shadow-lg">
            <i data-feather="user-check" class="w-10 h-10"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Active Learning</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Siswa aktif terlibat dalam proses pembelajaran melalui praktik
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-1 border-t-4 border-secondary-400">
            <div class="w-16 h-16 bg-gradient-to-br from-secondary-400 to-secondary-500 rounded-2xl flex items-center justify-center text-3xl mb-4 shadow-lg">
            <i data-feather="users" class="w-10 h-10"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Collaborative</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Kerja sama tim dan diskusi untuk membangun pemahaman
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-gray-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-1 border-t-4 border-primary-500">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center text-3xl mb-4 shadow-lg">
            <i data-feather="bar-chart-2" class="w-10 h-10"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Assessment</h3>
          <p class="text-gray-600 dark:text-gray-400">
            Evaluasi berkelanjutan untuk memantau perkembangan siswa
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
   <CTASection 
    id="kontak-cta"
    title="Tertarik dengan Program Kami?"
    description="Daftarkan putra-putri Anda sekarang dan berikan pendidikan terbaik untuk masa depan mereka"
    primaryButton={{ text: 'Hubungi Kami', href: '/kontak', icon: 'phone' }}
    secondaryButton={{ text: 'Pelajari Lebih Lanjut', href: '/program', icon: 'book' }}
   />
 
</Layout>
